[{"date": "2026-08-12", "symbol": "NSE:NIFTY", "close": 24435.95, "change": -35.75, "changePct": -0.15, "open": 24473.3, "dayHigh": 24473.3, "dayLow": 24265.95, "dayLowTime": "12:13 IST", "prevClose": 24471.7, "rsi14": 54.81, "sma200": 24745.41, "giftPremarketHigh": 24575, "giftPremarketTime": "08:55 IST", "summary": "Classic gap-and-fade day. NIFTY opened at 24,473.30 — which turned out to be the day's high — then sold off hard for the first ~3 hours, bottoming at 24,265.95 around 12:13 PM (a ~207-point, 0.85% drop). It then clawed back almost the entire move, recovering ~170 points into the close to finish nearly unchanged. GIFT Nifty had been signaling strength overnight, printing a premarket high of 24,575 around 08:55 IST. Cash NIFTY gapped in well below that read and immediately broke down — a bearish divergence from the premarket setup worth remembering next time GIFT looks strong into the open.", "levels": [{"name": "S2 (Jun 25 pivot)", "price": 24262, "type": "support", "status": "Held", "note": "Today's low (24,266) stopped 4 points above it. Key defense."}, {"name": "S1 (Jul 17 pivot)", "price": 24367, "type": "support", "status": "Broken intraday, reclaimed", "note": "Price recovered back above it into the close."}, {"name": "R2 (Apr swing high)", "price": 24602, "type": "resistance", "status": "Untested", "note": "GIFT's premarket strength faded before it got there."}, {"name": "R1 (Aug 3 swing high)", "price": 24774, "type": "resistance", "status": "Untested", "note": "Still the multi-week top."}, {"name": "200-day SMA", "price": 24745, "type": "resistance", "status": "Price below", "note": "Medium-term headwind."}], "watchTomorrow": ["24,262 (S2) — the line in the sand. A clean break opens the path toward the June support cluster (24,090–23,800).", "24,367 (S1) — reclaim and hold above this to confirm today's recovery wasn't just a dead-cat bounce.", "GIFT Nifty into the pre-open — check whether it's converging back toward strength or following through on today's fade.", "24,602 (R2) — first real resistance if bulls take control back."], "tomorrowLevels": [{"name": "R1 — Aug 3 swing high", "price": 24774, "type": "resistance", "action": "Take-profit / short zone", "note": "Multi-week top, untested. Fade here unless it breaks with strong volume."}, {"name": "200-day SMA", "price": 24745, "type": "resistance", "action": "Bias flip level", "note": "Price is below it. A close above flips the medium-term bias bullish — otherwise treat as a cap on rallies."}, {"name": "R2 — Apr swing high", "price": 24602, "type": "resistance", "action": "First target / add-on entry above", "note": "First hurdle for longs. A hold above on volume opens the door toward R1."}, {"name": "S1 — Jul 17 pivot", "price": 24367, "type": "support", "action": "Stop-loss reference for longs", "note": "Already broken and reclaimed once today. Use as invalidation — a close back below weakens the bullish case."}, {"name": "S2 — Jun 25 pivot", "price": 24262, "type": "support", "action": "Primary long-entry / bounce zone", "note": "Defended once already (today's low stopped 4 pts above it). First test = decent long entry with tight stop; a second quick retest is a weaker signal."}, {"name": "June support cluster", "price": 24090, "type": "support", "action": "Secondary long entry if S2 breaks", "note": "Next real demand zone (24,090–23,800) if S2 fails on a closing basis. Only relevant if S2 gives way."}], "notes": "Q&A follow-up: if 24,367 breaks again on a close (not just an intraday dip), 24,262 becomes the next real test — the same level already defended once today. If 24,262 also breaks on a sustained basis, there's no meaningful support until the June cluster around 24,090–23,800. Caveat: a level tested and defended once often holds again short-term, but repeated tests weaken it — watch whether any retest comes on lighter volume (good sign) or heavier volume (warning sign)."}, {"date": "2026-08-13", "symbol": "NSE:NIFTY", "close": 24395.85, "change": -40.1, "changePct": -0.16, "open": 24431.6, "dayHigh": 24431.6, "dayLow": 24311.4, "dayLowTime": "intraday", "prevClose": 24435.95, "rsi14": 53.33, "sma200": 24738.04, "giftPremarketHigh": null, "giftPremarketTime": null, "summary": "A quieter, lower-volatility repeat of yesterday's pattern. NIFTY opened at 24,431.60 — almost flat versus yesterday's 24,435.95 close — then dipped to test the S1 support zone, printing a low of 24,311.40 (a shallower dip than yesterday's test of S2). It recovered through the session to close at 24,395.85, down just 40.10 points (-0.16%). Volume (~296M) was in line with recent sessions, no acceleration. This is the second consecutive day S1 (24,367) was breached intraday but reclaimed by the close — a pattern worth watching rather than a clean break.", "levels": [{"name": "S1 (Jul 17 pivot)", "price": 24367, "type": "support", "status": "Broken intraday, reclaimed (2nd time in a row)", "note": "Low of 24,311.40 dipped below it; closed back above at 24,395.85."}, {"name": "S2 (Jun 25 pivot)", "price": 24262, "type": "support", "status": "Untested", "note": "Today's low (24,311.40) stayed well above it — no test today."}, {"name": "R2 (Apr swing high)", "price": 24602, "type": "resistance", "status": "Untested", "note": "Price stayed range-bound well below it all session."}, {"name": "R1 (Aug 3 swing high)", "price": 24774, "type": "resistance", "status": "Untested", "note": "Still the multi-week top, far overhead."}, {"name": "200-day SMA", "price": 24738, "type": "resistance", "status": "Price below", "note": "Gap to SMA widened slightly; still a medium-term headwind."}], "watchTomorrow": ["S1 (24,367) has now been tested and reclaimed twice in a row (Aug 12 & Aug 13) — a third breach that doesn't recover would be a meaningfully stronger bearish signal than the first two.", "S2 (24,262) remains untested since Aug 12 — still the key structural support if selling accelerates.", "Today's range (24,311.40–24,431.60) is now the near-term box — a break above 24,431.60 or below 24,311.40 likely sets the next directional move.", "200-day SMA (24,738) and R2 (24,602) remain the levels that need reclaiming for the medium-term bias to turn constructive again.", "Check GIFT Nifty into tomorrow's pre-open for early directional cues, same as before."], "tomorrowLevels": [{"name": "R1 — Aug 3 swing high", "price": 24774, "type": "resistance", "action": "Take-profit / short zone", "note": "Multi-week top, untested. Fade here unless it breaks with strong volume."}, {"name": "200-day SMA", "price": 24738, "type": "resistance", "action": "Bias flip level", "note": "Price is below it. A close above flips the medium-term bias bullish — otherwise treat as a cap on rallies."}, {"name": "R2 — Apr swing high", "price": 24602, "type": "resistance", "action": "First target / add-on entry above", "note": "First hurdle for longs. A hold above on volume opens the door toward R1."}, {"name": "Today's high", "price": 24431.6, "type": "resistance", "action": "Near-term breakout trigger", "note": "A move above today's high opens room back toward R2."}, {"name": "S1 — Jul 17 pivot", "price": 24367, "type": "support", "action": "Stop-loss reference for longs", "note": "Tested and reclaimed twice now (Aug 12 & 13). Still holding, but a third failed reclaim would be a real warning sign."}, {"name": "Today's low", "price": 24311.4, "type": "support", "action": "Near-term breakdown trigger", "note": "A close below today's low opens the path toward S2."}, {"name": "S2 — Jun 25 pivot", "price": 24262, "type": "support", "action": "Primary long-entry / bounce zone", "note": "Untested since Aug 12. First real test here would still be a decent long entry with a tight stop."}, {"name": "June support cluster", "price": 24090, "type": "support", "action": "Secondary long entry if S2 breaks", "note": "Next real demand zone (24,090–23,800) if S2 fails on a closing basis. Only relevant if S2 gives way."}], "notes": "Today extended the same theme as yesterday but with less intensity — smaller range, smaller loss, same S1 test-and-reclaim behavior. The market looks like it's consolidating in a ~24,300–24,435 box rather than trending in either direction. Two consecutive S1 defenses is a decent sign for bulls short-term, but watch for a third test happening too soon (within 1-2 sessions) — that pattern often precedes an eventual failure rather than continued strength."}, {"date": "2026-08-14", "symbol": "NSE:NIFTY", "close": 24366.0, "change": -29.85, "changePct": -0.12, "open": 24361.9, "dayHigh": 24405.2, "dayLow": 24296.8, "dayLowTime": "intraday", "prevClose": 24395.85, "rsi14": 52.21, "sma200": 24730.42, "giftPremarketHigh": null, "giftPremarketTime": null, "summary": "The third test of S1 finally broke the pattern. NIFTY opened at 24,361.90 — already below S1 (24,367) — dipped to 24,296.80 (the closest approach to S2 yet, though still ~35 points short of it), then only managed to close at 24,366.00, a single point below S1. Unlike Aug 12 and Aug 13, the close failed to clearly reclaim S1. The day also printed a lower high (24,405.20 vs Aug 13's 24,431.60) and a lower low (24,296.80 vs Aug 13's 24,311.40) — the first clean lower-high/lower-low session of this pullback, a short-term bearish structural signal even though the loss itself was modest (-0.12%).", "levels": [{"name": "S1 (Jul 17 pivot)", "price": 24367, "type": "support", "status": "Tested a 3rd time — failed to reclaim", "note": "Close (24,366.00) landed 1 point below S1, breaking the two-day pattern of clean reclaims."}, {"name": "S2 (Jun 25 pivot)", "price": 24262, "type": "support", "status": "Untested, but closer", "note": "Today's low (24,296.80) came within ~35 points — nearest approach since Aug 12."}, {"name": "R2 (Apr swing high)", "price": 24602, "type": "resistance", "status": "Untested", "note": "Still far overhead; not relevant while price drifts lower."}, {"name": "R1 (Aug 3 swing high)", "price": 24774, "type": "resistance", "status": "Untested", "note": "Still the multi-week top."}, {"name": "200-day SMA", "price": 24730, "type": "resistance", "status": "Price below", "note": "SMA itself is starting to drift down slightly as recent lower closes pull it in."}], "watchTomorrow": ["S1 (24,367) failed a clean reclaim for the first time — if the next session opens or trades below it without recovering early, S2 (24,262) becomes a near-term target rather than a distant backup.", "Watch whether the next session reclaims back above 24,367 early — a fast recovery keeps the range-bound story alive; failure within the first hour tilts toward a breakdown scenario.", "S2 (24,262) is now only ~100 points from the last close — meaningfully closer than it was on Aug 12/13.", "200-day SMA (24,730) and R2 (24,602) remain the levels needed to flip medium-term bias bullish — increasingly distant given the recent down-drift.", "Check GIFT Nifty premarket for early cues on the next session's open."], "tomorrowLevels": [{"name": "R1 — Aug 3 swing high", "price": 24774, "type": "resistance", "action": "Take-profit / short zone", "note": "Multi-week top, untested. Fade here unless it breaks with strong volume."}, {"name": "200-day SMA", "price": 24730, "type": "resistance", "action": "Bias flip level", "note": "Price is below it and the gap is roughly stable. A close above flips medium-term bias bullish."}, {"name": "R2 — Apr swing high", "price": 24602, "type": "resistance", "action": "First target / add-on entry above", "note": "First hurdle for longs, now more distant given the recent drift lower."}, {"name": "S1 — Jul 17 pivot / now pivot resistance", "price": 24367, "type": "resistance", "action": "Reclaim trigger — needed to neutralize breakdown risk", "note": "Failed a clean reclaim on the 3rd test (Aug 14). Now acts more like overhead resistance than clean support until reclaimed on a close."}, {"name": "Aug 14 low", "price": 24296.8, "type": "support", "action": "Near-term breakdown trigger", "note": "A close below this confirms the lower-high/lower-low sequence is continuing."}, {"name": "S2 — Jun 25 pivot", "price": 24262, "type": "support", "action": "Primary long-entry / bounce zone", "note": "Only ~100 points away now — meaningfully higher odds of being tested in the next session or two."}, {"name": "June support cluster", "price": 24090, "type": "support", "action": "Secondary long entry if S2 breaks", "note": "Next real demand zone (24,090–23,800) if S2 fails on a closing basis."}], "notes": "This session invalidates the 'two clean holds' read from Aug 13 — the third S1 test did not clearly reclaim, closing just 1 point below it, with a lower high and lower low versus the prior day. Not a breakdown yet (S2 still ~100 points away and untested), but the balance of evidence shifted more cautious. Per the earlier caveat: a level tested and defended repeatedly tends to weaken over successive tests, and that's exactly what played out here — worth treating S1 as flipped-to-resistance until it's reclaimed on a closing basis again."}, {"date": "2026-08-17", "symbol": "NSE:NIFTY", "close": 24287.65, "change": -78.35, "changePct": -0.32, "open": 24343.45, "dayHigh": 24360.1, "dayLow": 24226.95, "dayLowTime": "intraday", "prevClose": 24366.0, "rsi14": 49.26, "sma200": 24722.88, "giftPremarketHigh": null, "giftPremarketTime": null, "summary": "The downtrend structure that began Aug 13 extended for a third straight session (weekend in between). NIFTY opened at 24,343.45 — already below S1 — and never got close to challenging it, with the day's high (24,360.10) staying a full 7 points under S1 (24,367). More importantly, S2 (24,262) got its first real test since Aug 12: the low fell to 24,226.95, breaching S2 by about 35 points intraday, before recovering to close at 24,287.65 — back above S2, but well below S1. This marks the third consecutive lower-high/lower-low session (Aug 13 → 14 → 17), and RSI(14) slipped under 50 for the first time in this stretch, confirming momentum has shifted from neutral to mildly bearish (though still far from oversold).", "levels": [{"name": "S1 (Jul 17 pivot, now resistance)", "price": 24367, "type": "resistance", "status": "Held firmly — not even challenged", "note": "Today's high (24,360.10) stayed 7 points below it, confirming the flip from support to resistance flagged on Aug 14."}, {"name": "S2 (Jun 25 pivot)", "price": 24262, "type": "support", "status": "Tested intraday, reclaimed by close", "note": "Low of 24,226.95 breached S2 by ~35 points intraday; close (24,287.65) recovered back above it — first real test since Aug 12."}, {"name": "R2 (Apr swing high)", "price": 24602, "type": "resistance", "status": "Untested", "note": "Far overhead, not relevant while the downtrend continues."}, {"name": "R1 (Aug 3 swing high)", "price": 24774, "type": "resistance", "status": "Untested", "note": "Still the multi-week top."}, {"name": "200-day SMA", "price": 24723, "type": "resistance", "status": "Price below", "note": "Gap to SMA has widened over the week as price drifts lower."}], "watchTomorrow": ["S2 (24,262) has now been tested once and reclaimed on a closing basis — but the intraday breach means it's no longer 'clean' support. A second test soon would mirror what happened to S1 (initial reclaim, then failure on repeat testing).", "S1 (24,367) is confirmed resistance now — a close back above it is needed to break the current downtrend structure, not just a bounce.", "Three straight sessions of lower highs and lower lows (Aug 13→14→17) — this is a short-term downtrend, not just range consolidation anymore. Watch for either a higher low (reversal signal) or a clean break of 24,226.95 (continuation).", "RSI(14) dipped below 50 (49.26) for the first time in this stretch — momentum is fading, not just cooling, though still nowhere near oversold.", "If S2 fails cleanly (a close below 24,262), the June cluster (24,090–23,800) becomes the next real target."], "tomorrowLevels": [{"name": "R1 — Aug 3 swing high", "price": 24774, "type": "resistance", "action": "Take-profit / short zone", "note": "Multi-week top, untested. Fade here unless it breaks with strong volume."}, {"name": "200-day SMA", "price": 24723, "type": "resistance", "action": "Bias flip level", "note": "Price is below it and the gap is widening. A close above flips medium-term bias bullish."}, {"name": "R2 — Apr swing high", "price": 24602, "type": "resistance", "action": "First target / add-on entry above", "note": "First hurdle for longs, increasingly distant."}, {"name": "S1 — now resistance", "price": 24367, "type": "resistance", "action": "Downtrend-break trigger", "note": "Confirmed resistance today (high stayed 7 pts below it). A close above here is needed to invalidate the current downtrend structure."}, {"name": "Today's high", "price": 24360.1, "type": "resistance", "action": "Minor near-term hurdle", "note": "First small hurdle before S1 itself."}, {"name": "S2 — Jun 25 pivot", "price": 24262, "type": "support", "action": "Long-entry / bounce zone — lower conviction now", "note": "Tested once already today. A bounce here is a weaker signal than an untested level — size accordingly."}, {"name": "Today's low", "price": 24226.95, "type": "support", "action": "Near-term breakdown trigger", "note": "A close below this confirms S2 has failed and opens the path toward the June cluster."}, {"name": "June support cluster", "price": 24090, "type": "support", "action": "Secondary long entry if S2 breaks", "note": "Next real demand zone (24,090–23,800) if S2 fails on a closing basis."}], "notes": "The downtrend is now three sessions old (Aug 13→14→17) with consistent lower highs and lower lows. S2 got its first real test today and held on a closing basis, but the intraday breach weakens its 'clean support' status — the same pattern that played out with S1 over the prior three sessions before it eventually failed. RSI slipping under 50 adds some weight to the cautious read. Key question for the next session: does S2 hold a second test, or does it eventually fail the way S1 did after repeated tests?"}, {"date": "2026-08-18", "symbol": "NSE:NIFTY", "close": 24154.9, "change": -132.75, "changePct": -0.55, "open": 24223.85, "dayHigh": 24269.65, "dayLow": 24154.9, "dayLowTime": "close (no recovery)", "prevClose": 24287.65, "rsi14": 40.8, "sma200": 24713.82, "giftPremarketHigh": null, "giftPremarketTime": null, "summary": "The decisive break we'd been watching for. Unlike every prior test in this stretch, S2 (24,262) broke with no intraday recovery — NIFTY opened at 24,223.85 (already below S2), pushed as high as 24,269.65 briefly, then sold off into the close, finishing at 24,154.90 — right at the day's low. This is a clean breakdown, not another dip-and-reclaim: the close was ~108 points below S2 with zero bounce attempt into the bell. RSI(14) fell to ~40.8, its lowest reading in this stretch (was 49.26 just two sessions ago), confirming accelerating downside momentum, though still short of oversold (30).", "levels": [{"name": "S2 (Jun 25 pivot)", "price": 24262, "type": "support", "status": "Broken decisively — no recovery", "note": "Close (24,154.90) finished ~108 points below S2, at the day's low. First clean failure of this stretch."}, {"name": "S1 (Jul 17 pivot, resistance)", "price": 24367, "type": "resistance", "status": "Untested, further away", "note": "Day's high (24,269.65) stayed well below it — not remotely in play."}, {"name": "June support cluster (top)", "price": 24090, "type": "support", "status": "Not yet tested", "note": "Only ~65 points below today's close — now the immediate target."}, {"name": "R2 (Apr swing high)", "price": 24602, "type": "resistance", "status": "Untested", "note": "Far overhead, not relevant during active downside."}, {"name": "R1 (Aug 3 swing high)", "price": 24774, "type": "resistance", "status": "Untested", "note": "Still the multi-week top."}, {"name": "200-day SMA", "price": 24714, "type": "resistance", "status": "Price below", "note": "Gap to price has widened materially over the week."}], "watchTomorrow": ["S2 (24,262) has broken decisively with no recovery — this flips the read from 'range-bound with occasional dips' to an active short-term downtrend.", "The June support cluster (24,090–23,800) is now the immediate target — today's low is only ~65 points above the top of that zone, likely tested very soon.", "RSI(14) at ~40.8 is the lowest reading of this stretch, approaching but not yet at oversold (30) — a bounce-less slide through the June cluster would be a stronger capitulation signal.", "S1 (24,367) is firm resistance now — reclaiming it is a much bigger ask than it looked a week ago.", "Watch whether the June cluster produces any bounce reaction at all; if price cuts through without pausing, there's no clearly mapped support below it without fresh analysis."], "tomorrowLevels": [{"name": "R1 — Aug 3 swing high", "price": 24774, "type": "resistance", "action": "Take-profit / short zone", "note": "Multi-week top, untested. Very distant given the current trend."}, {"name": "200-day SMA", "price": 24714, "type": "resistance", "action": "Bias flip level", "note": "Price is well below it now. A close above would be a major trend-change signal, not just a bounce."}, {"name": "R2 — Apr swing high", "price": 24602, "type": "resistance", "action": "First target / add-on entry above", "note": "Very distant given current momentum."}, {"name": "S1 — now resistance", "price": 24367, "type": "resistance", "action": "Downtrend-break trigger", "note": "Reclaiming this on a close would meaningfully invalidate the current downtrend."}, {"name": "S2 — broken, now overhead", "price": 24262, "type": "resistance", "action": "Near-term reclaim trigger for a bounce case", "note": "A close back above this would be the first sign of a genuine short-term bounce, not just noise."}, {"name": "June cluster (top)", "price": 24090, "type": "support", "action": "Primary support test zone / bounce-watch", "note": "First real support test since the breakdown. Watch price action closely here rather than assuming it holds."}, {"name": "June cluster (bottom)", "price": 23800, "type": "support", "action": "Deeper support if 24,090 fails outright", "note": "If the top of the cluster doesn't hold, this is the next real reference point."}, {"name": "Today's low", "price": 24154.9, "type": "support", "action": "Immediate breakdown-continuation trigger", "note": "A move below this without pause confirms no support until the June cluster."}], "notes": "This is the decisive break flagged as a risk after S2's first test on Aug 17. Unlike every prior test in this stretch, there was no intraday recovery — the close sat right at the day's low, a materially weaker signature than the dip-and-reclaim pattern seen all last week. RSI's slide to ~40.8 confirms accelerating downside momentum, though it's not yet oversold. The next real technical test is the June support cluster (24,090–23,800), only ~65 points below this close — treat it as a genuine watch zone, not an assumed floor, given how the last 'clean' support level (S2) just failed without warning signs beyond the pattern itself."}, {"date": "2026-08-19", "symbol": "NSE:NIFTY", "close": 24078.3, "change": -76.6, "changePct": -0.32, "open": 24152.05, "dayHigh": 24172.85, "dayLow": 24025.65, "dayLowTime": "intraday", "prevClose": 24154.9, "rsi14": 43.29, "sma200": 24704.53, "giftPremarketHigh": null, "giftPremarketTime": null, "summary": "The June support cluster (24,090–23,800) got its first real test today, and — unlike yesterday's clean breakdown — showed a genuine partial bounce. NIFTY opened at 24,152.05, drifted down to a low of 24,025.65 (inside the cluster zone), then recovered roughly 52 points into the close, finishing at 24,078.30. The close stayed below the cluster's top boundary (24,090), so this isn't a clean reclaim, but it's the first session since Aug 13 that didn't close at or near its low. RSI(14) ticked up to ~43.3 from 40.8, consistent with the mild recovery, though still below the neutral 50 line.", "levels": [{"name": "June cluster — top", "price": 24090, "type": "resistance", "status": "Tested, partial recovery — close still below it", "note": "Low of 24,025.65 pushed into the cluster; close (24,078.30) bounced ~52 points off the low but stayed under this level."}, {"name": "June cluster — bottom", "price": 23800, "type": "support", "status": "Not reached", "note": "Today's low stayed well above it — the cluster's upper half absorbed the selling for now."}, {"name": "S2 — broken, now overhead", "price": 24262, "type": "resistance", "status": "Untested", "note": "Far above today's range; would need a much stronger reclaim to be relevant again."}, {"name": "S1 — resistance", "price": 24367, "type": "resistance", "status": "Untested", "note": "Increasingly distant given the current level."}, {"name": "200-day SMA", "price": 24705, "type": "resistance", "status": "Price below", "note": "Gap remains wide; not a near-term factor."}], "watchTomorrow": ["24,090 (cluster top) is the level to watch first — a close back above it would be the first real stabilization signal; staying below keeps the downtrend intact.", "23,800 (cluster bottom) hasn't been tested yet — if today's bounce fails and price breaks 24,025.65, that level comes into play next.", "RSI ticked up off its lowest reading of the stretch but remains below 50 — a bounce, not yet a confirmed momentum turn.", "This is the first session since Aug 13 that didn't close at or near its low — worth watching whether it becomes a real base or was just a one-day pause before continuation."], "tomorrowLevels": [{"name": "R1 — Aug 3 swing high", "price": 24774, "type": "resistance", "action": "Take-profit / short zone", "note": "Multi-week top, untested, very distant given the current trend."}, {"name": "200-day SMA", "price": 24705, "type": "resistance", "action": "Bias flip level", "note": "Far overhead; a close above would be a major trend-change signal, not just a bounce."}, {"name": "R2 — Apr swing high", "price": 24602, "type": "resistance", "action": "First target / add-on entry above", "note": "Very distant given current momentum."}, {"name": "S1 — resistance", "price": 24367, "type": "resistance", "action": "Downtrend-break trigger", "note": "Reclaiming this on a close would meaningfully invalidate the downtrend."}, {"name": "S2 — broken, overhead", "price": 24262, "type": "resistance", "action": "Intermediate reclaim trigger", "note": "A close back above here would build the bounce case further."}, {"name": "June cluster top", "price": 24090, "type": "resistance", "action": "Immediate reclaim trigger for stabilization case", "note": "Today's bounce stopped just short of reclaiming this. A close above it is the first real bullish signal in this stretch."}, {"name": "Today's low", "price": 24025.65, "type": "support", "action": "Near-term breakdown-continuation trigger", "note": "A break below this without a bounce would resume the downtrend toward the lower cluster boundary."}, {"name": "June cluster bottom", "price": 23800, "type": "support", "action": "Deeper support test if today's low breaks", "note": "Next real reference point if the upper half of the cluster fails outright."}], "notes": "After five straight sessions of one-directional moves (mostly down, several closing at or near the lows), today is the first with genuine two-way action — a dip into the June cluster followed by a real bounce, even if incomplete. This could be an early stabilization signal or just a pause before continuation; one partial-recovery day isn't enough to call a bottom, especially right after a break as clean as Aug 18's. The key tell for the next session: does the 24,090 reclaim happen, or does price roll back over toward 24,025.65 and below?"}, {"date": "2026-08-20", "symbol": "NSE:NIFTY", "close": 24231.85, "change": 153.55, "changePct": 0.64, "open": 24225.45, "dayHigh": 24265.15, "dayLow": 24184.55, "dayLowTime": "intraday", "prevClose": 24078.3, "rsi14": 48.78, "sma200": 24695.42, "giftPremarketHigh": null, "giftPremarketTime": null, "summary": "The stabilization signal flagged yesterday came through decisively. NIFTY gapped up to open at 24,225.45 — comfortably above the June cluster top (24,090) — and never looked back, trading in a tight ~80-point range (24,184.55–24,265.15) before closing at 24,231.85, up 153.55 points (+0.64%). This is the first green session since Aug 12, breaking a run of six straight down days. The day's high (24,265.15) briefly poked above S2 (24,262) — the level that broke cleanly on Aug 18 — but the close couldn't hold above it, leaving S2 tested but not reclaimed on a closing basis. RSI(14) jumped back to ~48.8, essentially neutral, reversing the momentum deterioration of the past week.", "levels": [{"name": "June cluster (top)", "price": 24090, "type": "support", "status": "Held decisively — reclaimed", "note": "Today's low (24,184.55) never came close to it; the gap-up open confirmed yesterday's bounce was genuine, not a fluke."}, {"name": "S2 — overhead resistance", "price": 24262, "type": "resistance", "status": "Tested intraday, not reclaimed on close", "note": "High (24,265.15) poked 3 points above S2, but the close (24,231.85) settled back below it — the key hurdle for the next session."}, {"name": "S1 — resistance", "price": 24367, "type": "resistance", "status": "Untested", "note": "Distance is narrowing as the bounce continues, but still a full step above today's action."}, {"name": "June cluster (bottom)", "price": 23800, "type": "support", "status": "Untested", "note": "Not relevant today; price never traded anywhere near it."}, {"name": "200-day SMA", "price": 24695, "type": "resistance", "status": "Price below", "note": "Gap has narrowed slightly with today's rally but remains sizeable."}], "watchTomorrow": ["S2 (24,262) is the immediate hurdle — a close above it (not just an intraday poke) would be the strongest bullish signal since this pullback began on Aug 13.", "24,090 (cluster top) flips back to key support if the bounce is real — a slide back below it without cause would undo today's stabilization read.", "RSI back near 50 confirms the momentum shift, but one strong day doesn't erase a six-day downtrend on its own — watch for follow-through, not just a single bounce.", "S1 (24,367) is the bigger structural test if S2 clears — that's roughly where this whole downtrend originated."], "tomorrowLevels": [{"name": "R1 — Aug 3 swing high", "price": 24774, "type": "resistance", "action": "Take-profit / short zone", "note": "Multi-week top, still distant but less so than a few days ago."}, {"name": "200-day SMA", "price": 24695, "type": "resistance", "action": "Bias flip level", "note": "Gap narrowing; a sustained rally could bring this into play within a week or two."}, {"name": "R2 — Apr swing high", "price": 24602, "type": "resistance", "action": "First target / add-on entry above", "note": "Still distant, but the bounce needs to clear S1 first regardless."}, {"name": "S1 — resistance", "price": 24367, "type": "resistance", "action": "Downtrend-break trigger", "note": "The real structural test if the bounce continues — this is close to where the down-move started."}, {"name": "S2 — overhead resistance", "price": 24262, "type": "resistance", "action": "Immediate reclaim trigger", "note": "Tested today (high 24,265.15), not yet closed above. Clearing this on a close is the next confirmation step."}, {"name": "June cluster top — now support", "price": 24090, "type": "support", "action": "Bounce-invalidation level", "note": "Held firmly today. A close back below this would undo the stabilization read and reopen downside risk."}, {"name": "Today's low", "price": 24184.55, "type": "support", "action": "Near-term pullback support", "note": "First support to watch within the bounce itself before the cluster top comes into play."}, {"name": "June cluster bottom", "price": 23800, "type": "support", "action": "Deep backup support", "note": "Only relevant if the bounce fails entirely and cluster top gives way again."}], "notes": "Six straight down sessions (Aug 13→14→17→18→19, plus the Aug 12 fade) finally broke with a strong reversal. The gap-up open and full-session hold above the June cluster is a meaningfully stronger signature than the tentative partial-bounce seen on Aug 19 — this looks like genuine buying interest, not just a pause. That said, one green day doesn't undo a six-day downtrend by itself. Real confirmation comes if S2 (24,262) clears on a closing basis in the next session or two — until then, this is 'stabilization in progress,' not a confirmed trend reversal."}, {"date": "2026-08-21", "symbol": "NSE:NIFTY", "close": 24252.0, "change": 20.15, "changePct": 0.08, "open": 24284.05, "dayHigh": 24284.05, "dayLow": 24206.8, "dayLowTime": "intraday", "prevClose": 24231.85, "rsi14": 46.89, "sma200": 24687.29, "giftPremarketHigh": null, "giftPremarketTime": null, "summary": "A notable failed breakout above S2. NIFTY gapped up to open at 24,284.05 — its high for the day — comfortably above S2 (24,262), suggesting yesterday's reclaim signal was confirming. Instead, the session sold off from the opening bell down to a low of 24,206.80, then recovered only modestly into the close at 24,252.00 (+20.15, +0.08%). The close landed back below S2 for the second straight session — this time after actually gapping above it at the open, a more cautionary signature than Aug 20's simple intraday poke. Net change was barely positive; this reads as stalling rather than continuation of the bounce.", "levels": [{"name": "S2 — overhead resistance", "price": 24262, "type": "resistance", "status": "Gapped above at open, faded, closed below — failed breakout", "note": "Open (24,284.05) was actually above S2, but the session sold off all day and closed ~10 points under it. Second straight session testing this level without a clean close above."}, {"name": "June cluster (top)", "price": 24090, "type": "support", "status": "Held, not retested", "note": "Today's low (24,206.80) stayed well clear of it — no threat to the stabilization read yet."}, {"name": "S1 — resistance", "price": 24367, "type": "resistance", "status": "Untested", "note": "Distance essentially unchanged from yesterday."}, {"name": "June cluster (bottom)", "price": 23800, "type": "support", "status": "Untested", "note": "Not relevant while price holds well above the cluster top."}, {"name": "200-day SMA", "price": 24687, "type": "resistance", "status": "Price below", "note": "Gap holding roughly steady."}], "watchTomorrow": ["S2 (24,262) has now failed twice in a row on a closing basis, including one outright gap-and-fade — treat it as firmer resistance than a single test would suggest. A clean close above it is needed, not just an intraday or opening move.", "Today's low (24,206.80) is the near-term support to watch — holding above it keeps the bounce intact; a break would raise doubts about the Aug 20 stabilization read.", "RSI eased slightly to ~46.9 from 48.8 — momentum isn't accelerating higher, consistent with the stalled price action.", "Watch whether the next session opens with follow-through selling (confirming the failed breakout) or another attempt at S2 (keeping the bounce case alive)."], "tomorrowLevels": [{"name": "R1 — Aug 3 swing high", "price": 24774, "type": "resistance", "action": "Take-profit / short zone", "note": "Multi-week top, still distant."}, {"name": "200-day SMA", "price": 24687, "type": "resistance", "action": "Bias flip level", "note": "Gap holding steady; not a near-term factor unless the bounce accelerates."}, {"name": "R2 — Apr swing high", "price": 24602, "type": "resistance", "action": "First target / add-on entry above", "note": "Distant; irrelevant until S1 and S2 both clear."}, {"name": "S1 — resistance", "price": 24367, "type": "resistance", "action": "Downtrend-break trigger", "note": "Still the bigger structural test once/if S2 clears."}, {"name": "S2 — overhead resistance", "price": 24262, "type": "resistance", "action": "Firmer reclaim trigger after 2 failed closes", "note": "Needs a decisive close above, not just a test — today's gap-and-fade raises the bar for the next attempt."}, {"name": "Today's low", "price": 24206.8, "type": "support", "action": "Near-term bounce-support trigger", "note": "Holding above this keeps the stabilization case intact for one more session."}, {"name": "June cluster top", "price": 24090, "type": "support", "action": "Bounce-invalidation level", "note": "Still the level that would undo the whole stabilization read if broken again."}, {"name": "June cluster bottom", "price": 23800, "type": "support", "action": "Deep backup support", "note": "Only relevant if both today's low and the cluster top fail."}], "notes": "Today's gap-and-fade above S2 is a more cautionary pattern than a simple intraday poke — opening above a resistance level and then selling off all session is often read as a failed breakout or possible bull trap. That said, the close held well above the June cluster and above yesterday's low, so the stabilization case isn't broken, just stalled. Two failed closes above S2 in a row raises the bar for the next attempt — watch for either a decisive close above 24,262 or a slide back toward 24,090 to resolve which way this goes."}, {"date": "2026-08-24", "symbol": "NSE:NIFTY", "close": 24219.05, "change": -32.95, "changePct": -0.14, "open": 24285.05, "dayHigh": 24313.0, "dayLow": 24144.3, "dayLowTime": "intraday", "prevClose": 24252.0, "rsi14": 45.78, "sma200": 24679.78, "giftPremarketHigh": null, "giftPremarketTime": null, "summary": "The third straight attempt at S2 failed, and this time the close also gave back Friday's gain. NIFTY opened at 24,285.05 and pushed to a fresh high of 24,313.00 — its best intraday push above S2 yet in this bounce — before reversing hard through the session down to a low of 24,144.30 (closer to the June cluster than any close since Aug 20's reversal). It recovered somewhat into the close at 24,219.05, but that's still below both S2 (24,262) and Friday's close (24,252.00), making this the first net-negative day since the Aug 20 turn. RSI(14) eased further to ~45.8, continuing the gentle fade from the 48.8 peak on Aug 20 — momentum is quietly rolling over even as price held above the June cluster.", "levels": [{"name": "S2 — overhead resistance", "price": 24262, "type": "resistance", "status": "Failed a third straight time — deepest fade yet", "note": "High (24,313.00) was the best push above S2 of the bounce, but the reversal down to 24,144.30 was also the sharpest — a wide failed-breakout range, not just a small poke."}, {"name": "June cluster (top)", "price": 24090, "type": "support", "status": "Held, but tested more closely", "note": "Today's low (24,144.30) came within ~54 points — the nearest approach since the Aug 19–20 bottoming action."}, {"name": "S1 — resistance", "price": 24367, "type": "resistance", "status": "Untested", "note": "Increasingly distant given today's reversal."}, {"name": "June cluster (bottom)", "price": 23800, "type": "support", "status": "Untested", "note": "Not relevant unless the cluster top gives way."}, {"name": "200-day SMA", "price": 24680, "type": "resistance", "status": "Price below", "note": "Gap holding roughly steady."}], "watchTomorrow": ["S2 (24,262) has now failed three consecutive sessions, with today's the widest failed-breakout range yet — this is starting to look like a genuine ceiling, not just noise.", "Today's low (24,144.30) is the closest approach to the June cluster since the Aug 20 reversal — a break below it would put the cluster top (24,090) back in play quickly.", "RSI has faded from 48.8 (Aug 20) to 45.8 (today) over four sessions — a slow momentum rollover worth tracking even though price is still range-bound.", "This is the first net red close since the Aug 20 turn — watch whether it's a one-off pullback within the range or the start of a renewed slide toward the cluster."], "tomorrowLevels": [{"name": "R1 — Aug 3 swing high", "price": 24774, "type": "resistance", "action": "Take-profit / short zone", "note": "Multi-week top, still distant."}, {"name": "200-day SMA", "price": 24680, "type": "resistance", "action": "Bias flip level", "note": "Not a near-term factor while the market is stuck below S2."}, {"name": "R2 — Apr swing high", "price": 24602, "type": "resistance", "action": "First target / add-on entry above", "note": "Irrelevant until S1 and S2 both clear."}, {"name": "S1 — resistance", "price": 24367, "type": "resistance", "action": "Downtrend-break trigger", "note": "Still the bigger structural test, now more distant after today's fade."}, {"name": "S2 — overhead resistance", "price": 24262, "type": "resistance", "action": "Confirmed range ceiling until proven otherwise", "note": "Three failed closes running, including today's wide reversal. Needs a decisive close above to change the read."}, {"name": "Today's low", "price": 24144.3, "type": "support", "action": "Near-term support to hold", "note": "A break below this without recovery raises the odds of a retest of the June cluster top."}, {"name": "June cluster top", "price": 24090, "type": "support", "action": "Bounce-invalidation level", "note": "Getting closer again. Still the level that would undo the whole stabilization read if broken."}, {"name": "June cluster bottom", "price": 23800, "type": "support", "action": "Deep backup support", "note": "Only relevant if both today's low and the cluster top fail."}], "notes": "Three consecutive failed attempts at S2 (Aug 20 intraday poke, Aug 21 gap-and-fade, today's wider reversal) is a meaningful pattern — the market has tried and failed to clear this level three times in a row, and today's range was the widest failed breakout yet. RSI's slow fade from 48.8 to 45.8 over four sessions adds a subtle bearish tell even though price itself hasn't broken down. The June cluster (24,090) remains the line that matters most — as long as pullbacks stay above it, this reads as a range between 24,090 and 24,262 rather than a resumed downtrend, but a break of today's low would be the first step toward testing that thesis."}, {"date": "2026-08-25", "symbol": "NSE:NIFTY", "close": 24334.55, "change": 115.5, "changePct": 0.48, "open": 24175.75, "dayHigh": 24334.55, "dayLow": 24115.45, "dayLowTime": "intraday", "prevClose": 24219.05, "rsi14": 52.75, "sma200": 24672.63, "giftPremarketHigh": null, "giftPremarketTime": null, "summary": "S2 finally broke on the fourth attempt, and this time with real conviction. NIFTY opened at 24,175.75 — dipping first to a low of 24,115.45, its closest approach yet to the June cluster top (24,090) — then reversed and rallied all session to close at 24,334.55, the day's high. This is a clean, decisive close above S2 (24,262) for the first time since the level broke on Aug 18, and it's also the strongest single-session gain of the entire bounce (+115.50, +0.48%), closing at the top of the day's range rather than fading like the prior three attempts. RSI(14) climbed back above the neutral line to ~52.75, its highest reading since before the Aug 13 downtrend began, and price is now closing in on S1 (24,367), only ~32 points away.", "levels": [{"name": "S2 — reclaimed", "price": 24262, "type": "support", "status": "Broken and closed above decisively — flips back to support", "note": "Close (24,334.55) landed 72 points above S2 at the day's high, after three prior failed attempts (Aug 20, 21, 24). This is the first clean win."}, {"name": "S1 — resistance, now nearby", "price": 24367, "type": "resistance", "status": "Untested but close", "note": "Only ~32 points above today's close — the next real structural test if the rally continues."}, {"name": "June cluster (top)", "price": 24090, "type": "support", "status": "Held, tested closely intraday", "note": "Today's low (24,115.45) came within ~25 points before the reversal — the closest test since Aug 19–20, then a strong rally away from it."}, {"name": "June cluster (bottom)", "price": 23800, "type": "support", "status": "Untested", "note": "Not relevant given today's strong reversal away from the cluster."}, {"name": "200-day SMA", "price": 24673, "type": "resistance", "status": "Price below, gap narrowing", "note": "Getting closer as the bounce extends; still a step above S1 and R2."}], "watchTomorrow": ["S1 (24,367) is the immediate next test — only ~32 points away. A clean close above it would fully invalidate the Aug 13–19 downtrend structure.", "S2 (24,262) has flipped back to support after four attempts — a slide back below it on the next pullback would be a concerning reversal of today's breakout.", "RSI at ~52.75 is the strongest reading since before this whole pullback started — momentum has genuinely turned, not just stabilized.", "Today's low (24,115.45) marks a solid higher-low versus Aug 19's low (24,025.65) and Aug 18's close (24,154.90) — a constructive structural signal if it holds on the next dip.", "Watch for whether tomorrow builds on today's strength (follow-through toward S1/R2) or gives back gains in a pullback — the quality of the next pullback (does it hold above S2?) will confirm whether this breakout is real."], "tomorrowLevels": [{"name": "R1 — Aug 3 swing high", "price": 24774, "type": "resistance", "action": "Take-profit / short zone", "note": "Multi-week top; still distant but meaningfully closer than a week ago."}, {"name": "200-day SMA", "price": 24673, "type": "resistance", "action": "Bias flip level", "note": "Gap narrowing with today's rally; could come into play within the next couple of weeks if the trend continues."}, {"name": "R2 — Apr swing high", "price": 24602, "type": "resistance", "action": "Next target after S1 clears", "note": "The level after S1 — relevant once/if S1 breaks."}, {"name": "S1 — Jul 17 pivot, now key resistance", "price": 24367, "type": "resistance", "action": "Primary breakout confirmation trigger", "note": "Only ~32 points away. Clearing this on a close is the biggest remaining test of whether the downtrend is truly over."}, {"name": "S2 — reclaimed, now support", "price": 24262, "type": "support", "action": "Stop-loss / breakout-validation level", "note": "First clean close above after 3 failed attempts. Holding above it on the next dip confirms the breakout; losing it again would be a red flag."}, {"name": "Today's low", "price": 24115.45, "type": "support", "action": "Near-term higher-low reference", "note": "A solid higher low vs. recent lows — worth watching if tested again."}, {"name": "June cluster top", "price": 24090, "type": "support", "action": "Deep bounce-invalidation level", "note": "Still the level that would seriously damage the stabilization thesis if broken, though today's strong reversal makes that look less likely near-term."}, {"name": "June cluster bottom", "price": 23800, "type": "support", "action": "Very deep backup support", "note": "Only relevant in a serious reversal scenario."}], "notes": "Fourth time's the charm — S2 broke cleanly after three failed attempts (Aug 20, 21, 24), and today's close at the day's high with the strongest gain of the bounce is a meaningfully stronger signature than any prior attempt. RSI's move to ~52.75 (highest since before Aug 13) confirms genuine momentum, not just a bounce. The next real test is S1 (24,367), just ~32 points away — clearing that would fully undo the down-move that started Aug 13. Key thing to verify over the next session or two: does S2 hold as support on the next pullback (confirming the breakout) or does price slip back below it (repeating the Aug 20-24 pattern)?"}, {"date": "2026-08-26", "symbol": "NSE:NIFTY", "close": 24207.75, "change": -126.8, "changePct": -0.52, "open": 24341.95, "dayHigh": 24378.6, "dayLow": 24207.75, "dayLowTime": "close (no recovery)", "prevClose": 24334.55, "rsi14": 47.96, "sma200": 24665.68, "giftPremarketHigh": null, "giftPremarketTime": null, "summary": "The exact test flagged yesterday played out, and it failed. NIFTY opened at 24,341.95 — already close to S1 — and briefly pushed through it to a high of 24,378.60, clearing S1 (24,367) for the first time since the downtrend began. But the session reversed hard from there, selling off continuously through the day down to a close of 24,207.75, right at the day's low. That close is not just below S1, it's also back below S2 (24,262) — undoing yesterday's breakout confirmation entirely in a single session. This is the sharpest single-day reversal since Aug 18's breakdown, wiping out all of yesterday's gain and then some (-126.80, -0.52%). RSI(14) slipped back to ~47.96 from 52.75, erasing the bullish momentum shift from Aug 25.", "levels": [{"name": "S1 — briefly cleared, then rejected", "price": 24367, "type": "resistance", "status": "Touched intraday (high 24,378.60), rejected hard, confirmed as resistance", "note": "First test above S1 since the downtrend began on Aug 13 — but the sharp reversal makes this a rejection, not a breakout."}, {"name": "S2 — lost again after 1 day above it", "price": 24262, "type": "resistance", "status": "Broken back below — Aug 25's reclaim did not hold", "note": "Close (24,207.75) landed ~54 points below S2, undoing the breakout confirmed just one session earlier."}, {"name": "June cluster (top)", "price": 24090, "type": "support", "status": "Untested today", "note": "Today's low stayed well above it, but it's now back in view as the next real support if the reversal continues."}, {"name": "June cluster (bottom)", "price": 23800, "type": "support", "status": "Untested", "note": "Not relevant unless the cluster top comes under renewed pressure."}, {"name": "200-day SMA", "price": 24666, "type": "resistance", "status": "Price below", "note": "Gap widened again after today's reversal."}], "watchTomorrow": ["S1 (24,367) is confirmed as firm resistance — cleared briefly intraday but rejected hard, a stronger rejection signal than any of the S2 fails.", "S2 (24,262) failing to hold after only one session above it is the bigger concern — it suggests yesterday's breakout may have been a false signal rather than a genuine trend change.", "RSI's round-trip from 52.75 back to 47.96 in a single session shows how quickly the momentum picture can flip — treat any single day's RSI reading with caution right now.", "Watch whether tomorrow holds above today's low (24,207.75) or continues sliding toward the June cluster (24,090) — a break of today's low would reopen the case for a retest of that zone.", "This is now a genuinely two-sided, choppy market (Aug 20 up, Aug 21 down, Aug 24 down, Aug 25 up big, Aug 26 down big) rather than a clean trend in either direction — position sizing and conviction should reflect that uncertainty."], "tomorrowLevels": [{"name": "R1 — Aug 3 swing high", "price": 24774, "type": "resistance", "action": "Take-profit / short zone", "note": "Multi-week top; distant again after today's reversal."}, {"name": "200-day SMA", "price": 24666, "type": "resistance", "action": "Bias flip level", "note": "Gap widened; not a near-term factor."}, {"name": "R2 — Apr swing high", "price": 24602, "type": "resistance", "action": "Distant target", "note": "Irrelevant until S1 clears cleanly, which just failed today."}, {"name": "S1 — confirmed resistance", "price": 24367, "type": "resistance", "action": "Primary breakout trigger — now a harder test", "note": "Touched and rejected today. Needs a much more convincing close above to be taken seriously next time."}, {"name": "Today's high", "price": 24378.6, "type": "resistance", "action": "Failed-breakout marker", "note": "The exact high of today's rejection — a close above this would be a stronger signal than merely clearing S1."}, {"name": "S2 — lost again", "price": 24262, "type": "resistance", "action": "Reclaim trigger to revive the bullish case", "note": "Held for only one session. Reclaiming it again would need to happen soon to keep the breakout thesis alive."}, {"name": "Today's low / close", "price": 24207.75, "type": "support", "action": "Near-term support to hold", "note": "A break below this without recovery raises the odds of a retest of the June cluster."}, {"name": "June cluster top", "price": 24090, "type": "support", "action": "Bounce-invalidation level", "note": "Back in play as the next real support test if the reversal extends."}], "notes": "This single session undid the entire Aug 25 breakout narrative — S1 was touched and firmly rejected, and S2 (reclaimed just one day earlier) was lost again. The pattern over the last week (Aug 20 +, 21 -, 24 -, 25 ++, 26 --) looks like a genuinely choppy, two-sided market rather than a clean trend, which is a different risk environment than the one-directional moves seen Aug 13-19. Until either S1 clears with real conviction (a close well above 24,378.60) or the June cluster gets tested again, treat this as a market without a clear directional edge — the kind of environment where overtrading or over-committing to either a bullish or bearish thesis is most likely to hurt."}, {"date": "2026-08-27", "symbol": "NSE:NIFTY", "close": 24090.85, "change": -116.9, "changePct": -0.48, "open": 24277.6, "dayHigh": 24297.45, "dayLow": 24090.85, "dayLowTime": "close (no recovery)", "prevClose": 24207.75, "rsi14": 44.5, "sma200": 24658.59, "giftPremarketHigh": null, "giftPremarketTime": null, "summary": "The choppy back-and-forth of the last week resolved to the downside, and decisively so. NIFTY opened at 24,277.60, traded up modestly to a high of 24,297.45, then sold off continuously through the session with no recovery attempt, closing at 24,090.85 — right at the day's low and landing almost exactly on the June cluster top (24,090). This is the sharpest directional close since Aug 18's original breakdown, and it undoes essentially all of the Aug 20–25 bounce: price is now back to levels last seen during the initial capitulation, testing the exact same support zone that held (barely) on Aug 19–20. RSI(14) fell to ~44.5 from 47.96, resuming the momentum deterioration that the Aug 25 rally had temporarily reversed.", "levels": [{"name": "June cluster (top) — critical test", "price": 24090, "type": "support", "status": "Closed almost exactly on this level — no bounce", "note": "Close (24,090.85) landed just 0.85 points above the level itself, with zero recovery into the bell. The most direct test of this support since it first formed on Aug 18–19."}, {"name": "S2 (24,262) — lost again, further this time", "price": 24262, "type": "resistance", "status": "Broken, and by a wider margin than Aug 26", "note": "Close is now ~171 points below S2, versus ~54 points on Aug 26 — the bounce structure from Aug 20–25 is fully undone."}, {"name": "S1 (24,367) — resistance", "price": 24367, "type": "resistance", "status": "Untested, increasingly distant", "note": "Today's high (24,297.45) stayed well below it."}, {"name": "June cluster (bottom)", "price": 23800, "type": "support", "status": "Not yet tested", "note": "The next real reference point if today's close doesn't hold and the cluster top gives way on the next session."}, {"name": "200-day SMA", "price": 24659, "type": "resistance", "status": "Price below", "note": "Gap has widened again after this week's round-trip."}], "watchTomorrow": ["24,090 (cluster top) is the single most important level right now — today's close sat almost exactly on it. A bounce here would be the second successful defense of this zone (after Aug 19–20); a clean break below would open the door to the 23,800 lower boundary.", "This week's pattern (Aug 20 up, 21 down, 24 down, 25 up big, 26 down big, 27 down big) has now fully unwound the bounce — the choppy two-sided market may be resolving into a resumed downtrend rather than staying range-bound.", "RSI at ~44.5 is fading again but still well short of the ~40.8 low from Aug 18 — there's room for further deterioration before this reaches oversold territory.", "Watch whether tomorrow opens with a bounce attempt off 24,090 (repeating the Aug 19–20 stabilization pattern) or gaps/trades straight through it (confirming a deeper leg down).", "Given the choppiness of the past two weeks, treat any single day's move — up or down — with some caution until it's confirmed by follow-through."], "tomorrowLevels": [{"name": "R1 — Aug 3 swing high", "price": 24774, "type": "resistance", "action": "Take-profit / short zone", "note": "Multi-week top; very distant now."}, {"name": "200-day SMA", "price": 24659, "type": "resistance", "action": "Bias flip level", "note": "Far overhead; not a near-term factor."}, {"name": "R2 — Apr swing high", "price": 24602, "type": "resistance", "action": "Distant target", "note": "Irrelevant while price sits at the June cluster."}, {"name": "S1 — resistance", "price": 24367, "type": "resistance", "action": "Downtrend-break trigger", "note": "Increasingly distant; a close above here would need a very strong multi-day rally."}, {"name": "S2 — overhead resistance", "price": 24262, "type": "resistance", "action": "First reclaim trigger for any bounce case", "note": "Would need to clear this again to revive last week's breakout narrative."}, {"name": "Today's high", "price": 24297.45, "type": "resistance", "action": "Near-term bounce marker", "note": "A reclaim above this on the next session would be an early sign of stabilization."}, {"name": "June cluster top — critical support", "price": 24090, "type": "support", "action": "Primary support test — highest-conviction watch level", "note": "Today's close sat almost exactly here. Holding this on a closing basis over the next session or two is the key bullish case; losing it points toward 23,800."}, {"name": "June cluster bottom", "price": 23800, "type": "support", "action": "Next support if 24,090 fails", "note": "The deeper reference point if today's close doesn't hold and the cluster top breaks on a closing basis."}], "notes": "This session effectively closes the loop on the past two weeks of chop: the Aug 20–25 bounce is now fully round-tripped, and price sits right back at the same June cluster support that first got tested on Aug 18–20. The fact that it held (barely) the first time gives some reason to expect another defense attempt, but today's close showed zero intraday recovery — a materially weaker signature than the Aug 19 partial bounce that started the prior stabilization. Whether 24,090 holds again over the next session or two is now the single most important question for this market."}, {"date": "2026-08-28", "symbol": "NSE:NIFTY", "close": 24175.65, "change": 84.8, "changePct": 0.35, "open": 24122.6, "dayHigh": 24188.3, "dayLow": 24076.85, "dayLowTime": "intraday", "prevClose": 24090.85, "rsi14": 46.6, "sma200": 24652.01, "giftPremarketHigh": null, "giftPremarketTime": null, "summary": "BACKFILLED on 2026-08-31 — this session was originally skipped in the journal. OHLC and volume are from the actual daily feed; RSI and the 200-day SMA are estimates (see notes). Aug 28 was the second successful defense of the June support cluster (24,090), closely mirroring the Aug 19-20 sequence. After Aug 27 closed right on the zone at 24,090.85 (a sharp, recovery-less close), NIFTY opened Aug 28 at 24,122.60 — just above the cluster top — dipped to a low of 24,076.85 (a marginal ~13-point breach of 24,090), then recovered through the session to close at 24,175.65, up 84.80 points (+0.35%). This is the first green close since Aug 25 and the fourth close-basis hold of the 24,090 zone since Aug 19. It is a weaker bounce than Aug 20's gap-up, though — the gain was modest, the close stayed below the day's high (24,188.30) and far below S2 (24,262), and the low never challenged the Aug 19 low (24,025.65). Reads as a stabilisation attempt, not a confirmed reversal. Daily RSI(14) is estimated at ~46.6, a mild tick up from Aug 27's 44.5, still below the neutral 50 line.", "levels": [{"name": "June cluster (top)", "price": 24090, "type": "support", "status": "Breached ~13 pts intraday, reclaimed on the close", "note": "Low of 24,076.85 dipped just below it; close (24,175.65) recovered ~85 pts back above. Fourth close-basis hold of this level since Aug 19."}, {"name": "Aug 28 low", "price": 24076.85, "type": "support", "status": "Marginal new intraday low vs Aug 27, held", "note": "Stayed well above the Aug 19 low (24,025.65); the recovery from here drove the green close."}, {"name": "S2 (Jun 25 pivot)", "price": 24262, "type": "resistance", "status": "Untested — bounce stalled well below it", "note": "Day's high (24,188.30) stayed ~74 pts under S2. Reclaimed only briefly on Aug 25 before failing Aug 26."}, {"name": "S1 (Jul 17 pivot)", "price": 24367, "type": "resistance", "status": "Distant, untested", "note": "Touched and rejected Aug 26; not in play."}, {"name": "200-day SMA", "price": 24652.01, "type": "resistance", "status": "Price ~-1.9% below (true 200-DMA)", "note": "200-period simple MA of daily close, computed from 200 daily bars. Deep overhead - not a near-term factor."}], "watchTomorrow": ["24,090 (June cluster top) was reclaimed on the close for a fourth successful defense since Aug 19 — a move back below it on the next session would be the first genuine failure of this zone.", "The bounce is modest (+0.35%, close below the day's high of 24,188.30) — watch for follow-through next session or another rollover toward the cluster.", "S2 (24,262) remains the ceiling: three failed closes there (Aug 20/21/24), reclaimed Aug 25, lost again Aug 26. It must be cleared on a close to revive the bounce case.", "Daily RSI (~46.6 est.) ticked up from Aug 27's 44.5 — mild improvement, still below 50; not yet a momentum turn.", "Aug 19 low (24,025.65) is the deeper line in the sand if the cluster top gives way next session."], "tomorrowLevels": [{"name": "S1 — Jul 17 pivot", "price": 24367, "type": "resistance", "action": "Downtrend-break trigger", "note": "A close above here would be needed to seriously challenge the down-structure; distant."}, {"name": "S2 — Jun 25 pivot", "price": 24262, "type": "resistance", "action": "First reclaim trigger for a bounce case", "note": "Needs a decisive close above to revive the Aug 25 breakout narrative."}, {"name": "Aug 28 high", "price": 24188.3, "type": "resistance", "action": "Near-term breakout trigger", "note": "A move above the day's high opens room back toward S2."}, {"name": "June cluster top", "price": 24090, "type": "support", "action": "Bounce-invalidation level", "note": "Reclaimed on the close today. A close back below it undoes the stabilisation read and reopens downside."}, {"name": "Aug 28 low", "price": 24076.85, "type": "support", "action": "Near-term breakdown trigger", "note": "A close below this confirms the cluster top has failed again."}, {"name": "Aug 19 low", "price": 24025.65, "type": "support", "action": "Deeper support reference", "note": "Next real level below the cluster top."}, {"name": "June cluster bottom", "price": 23800, "type": "support", "action": "Backup support if 24,090 fails outright", "note": "The deeper reference point once the upper half of the cluster is gone on a closing basis."}], "notes": "This entry was BACKFILLED on 2026-08-31; Aug 28 (Fri) was originally skipped. OHLC and volume (~296M) are from the live daily feed and are final. rsi14 (~46.6) and sma200 (~24,651) are ESTIMATES — the historical values could not be read directly (TradingView replay would not run on this index symbol). RSI is interpolated via Wilder's recursion anchored to the journal's Aug 26 (47.96) and Aug 27 (44.50) readings and calibrated against the live Aug 31 reading (43.70); treat it as +/- ~1 point. Structural read: Aug 28 was the second successful defense of the June cluster (24,090), mirroring Aug 19-20 — Aug 27 closed on the zone, Aug 28 dipped ~13 pts below intraday then recovered to close +84.80 back above it (fourth close-basis hold since Aug 19). Weaker than Aug 20's gap-up: modest gain, close below the day's high and far below S2, so a stabilisation attempt rather than a confirmed reversal. Hindsight (known when backfilled): the very next session (Aug 31) broke to a new low of 23,993.60 before closing at 24,080.40 — the zone was retested hard immediately, and Aug 28's bounce did not get follow-through.", "cpr": {"width": 69, "label": "moderate", "range": "24,125.28-24,194.15", "basis": "from 2026-08-27 H/L/C"}}, {"date": "2026-08-31", "symbol": "NSE:NIFTY", "close": 24080.4, "change": -95.25, "changePct": -0.39, "open": 24117.55, "dayHigh": 24128.7, "dayLow": 23993.6, "dayLowTime": "late morning", "prevClose": 24175.65, "rsi14": 43.7, "sma200": 24644.54, "giftPremarketHigh": null, "giftPremarketTime": null, "summary": "FINALISED (session closed 15:30 IST) — this replaces the two intraday snapshots logged earlier today. Note: Aug 28 (Fri) is not in this journal; it closed at 24,175.65, used here as prevClose. Today was a near-carbon-copy of Aug 19. NIFTY opened at 24,117.55 (already below the June cluster top at 24,090), sold off through the morning to a new pullback low of 23,993.60 — the first sub-24,000 print of this entire down-move and a break of both the Aug 19 low (24,025.65) and Aug 18's close (24,154.90) — then recovered roughly 87 points through the afternoon to close at 24,080.40, just 10 points below the cluster top. Net loss was modest at -95.25 points (-0.39%). Closing volume (~707M) ran well above the recent daily average (~300M). This is only the second close below 24,090 in this whole stretch (after Aug 19), and it's marginal — the ~87-point bounce off the low means the zone is bruised, not decisively broken. Daily RSI(14) finished at 43.70, still ABOVE the Aug 18 stretch-low (~40.8) despite price making a lower low — the minor bullish divergence held into the close. The daily Smart Money Concepts study continues to show 'CHoCH' (bearish change of character).", "levels": [{"name": "June cluster (top)", "price": 24090, "type": "support", "status": "Breached to 23,993.60 intraday; closed 10 pts below (24,080.40)", "note": "Second sub-24,090 close of the stretch (after Aug 19). Not a decisive failure given the ~87-pt recovery off the low, but no longer clean support — a second consecutive close below would confirm the break."}, {"name": "24,000 round number / today's low", "price": 23993.6, "type": "support", "status": "New pullback low, bounced ~87 pts into the close", "note": "First sub-24,000 print of the down-move. This is now the near-term line in the sand; a close below it opens 23,800 with little support in between."}, {"name": "June cluster (bottom)", "price": 23800, "type": "support", "status": "Untested", "note": "Next real reference point if today's low gives way on a closing basis."}, {"name": "S2 (Jun 25 pivot)", "price": 24262, "type": "resistance", "status": "Well overhead, untested today", "note": "~180 pts above the close; only briefly reclaimed on Aug 25 before failing."}, {"name": "S1 (Jul 17 pivot)", "price": 24367, "type": "resistance", "status": "Distant, untested", "note": "Touched and firmly rejected Aug 26; not in play near-term."}, {"name": "200-day SMA", "price": 24644.54, "type": "resistance", "status": "Price ~-2.3% below (true 200-DMA)", "note": "200-period simple MA of daily close, computed from 200 daily bars. Deep overhead - not a near-term factor."}], "watchTomorrow": ["Direct echo of the Aug 19 to Aug 20 setup: today was a dip below 24,090 with a recovery close just under it. Aug 20 resolved its analogue with a gap-up reclaim and stabilisation. The next session is the tell — reclaim 24,090 on a close (bullish, mirrors Aug 20) or roll back toward 23,993.60 (bearish).", "24,090 (June cluster top) — a close back above it neutralises today's marginal break; a second consecutive close below keeps the pressure on and points toward 23,800.", "23,993.60 (today's low) / the 24,000 round number — a close below opens the 23,800 lower cluster boundary with little support in between.", "Daily RSI (43.70) held above the Aug 18 stretch-low (~40.8) even though price made a lower low — the minor bullish divergence is intact. Watch for confirmation (a green day) or failure (RSI breaks 40).", "The ~87-point recovery off the low is the first constructive close since Aug 25 — it needs follow-through next session, not a one-off."], "tomorrowLevels": [{"name": "S1 — Jul 17 pivot", "price": 24367, "type": "resistance", "action": "Downtrend-break trigger", "note": "A close above here would be needed to seriously challenge the down-structure; very distant."}, {"name": "S2 — Jun 25 pivot", "price": 24262, "type": "resistance", "action": "First reclaim trigger for a bounce case", "note": "Would need to clear this to revive the Aug 25 breakout narrative."}, {"name": "Friday close", "price": 24175.65, "type": "resistance", "action": "Bounce-neutralisation level", "note": "Reclaiming Friday's close would fully undo today's breakdown."}, {"name": "Today's high", "price": 24128.7, "type": "resistance", "action": "Near-term hurdle", "note": "First level a recovery must clear before Friday's close comes into play."}, {"name": "June cluster top", "price": 24090, "type": "resistance", "action": "Primary reclaim trigger — close above = stabilisation (mirrors Aug 20)", "note": "Closed 10 pts below it today. A close back above is the first real bullish signal; failure to reclaim confirms the marginal break."}, {"name": "Today's low", "price": 23993.6, "type": "support", "action": "Line in the sand", "note": "A decisive close below this points straight at 23,800."}, {"name": "June cluster bottom", "price": 23800, "type": "support", "action": "Next real support if today's low fails on a close", "note": "The deeper reference point once the upper half of the cluster is gone on a closing basis."}], "notes": "This entry is FINALISED (session closed 15:30 IST) and replaces the two intraday snapshots logged earlier for 2026-08-31. Caveats: (1) the journal has no Aug 28 (Fri) entry; that session closed at 24,175.65 and is used as prevClose. (2) sma200 (~24,644) is extrapolated from the downtrend in the 200-day average, not read directly. (3) Closing volume (~707M) ran well above the ~300M recent daily average. Structural read: a near-carbon-copy of Aug 19 — a dip through the June cluster (24,090) to a marginal new low (23,993.60), then a recovery to close just below the cluster top (24,080.40). Aug 19's analogue preceded the Aug 20 gap-up stabilisation. Technically this is the second sub-24,090 close of the stretch, so the zone is bruised but not decisively broken given the ~87-pt bounce off the low. Daily RSI (43.70) holding above the Aug 18 low despite a lower price low keeps a minor bullish divergence alive. The next session decides it: reclaim 24,090 (bullish, mirrors Aug 20) or roll over toward 23,800. Drivers today: renewed US-Iran tensions lifted Brent above $90/bbl (risk-off across Asia); metals/IT/realty led losses, FIIs net sold 5,039.80 cr on Aug 28 vs DIIs +5,183.93 cr. Calendar ahead is in newsEvents (Sep 1 India auto sales + Mfg PMI, US ISM/JOLTS; Sep 5 US payrolls).", "newsEvents": [{"category": "Fri, Sep 4", "text": "US August non-farm payrolls + unemployment rate - the week's main event for global rate-cut odds and EM risk appetite; India reacts on Sep 5 / Mon Sep 7.", "source": "Trading Economics; FXStreet"}, {"category": "Ongoing risk", "text": "US-Iran military tension keeping Brent above $90/bbl - India imports ~85% of its crude, so escalation or de-escalation in oil is the key near-term swing factor for Nifty (inflation, INR, import bill).", "source": "Business Standard"}], "cpr": {"width": 29, "label": "narrow", "range": "24,132.57-24,161.29", "basis": "from 2026-08-28 H/L/C"}}, {"date": "2026-09-01", "symbol": "NSE:NIFTY", "close": 24055.8, "change": -24.6, "changePct": -0.1, "open": 24077.55, "dayHigh": 24143.15, "dayLow": 23952.55, "dayLowTime": "intraday", "prevClose": 24080.4, "rsi14": 42.86, "sma200": 24636.34, "giftPremarketHigh": null, "giftPremarketTime": null, "summary": "FINALISED (session closed 15:30 IST). Second straight down day, but only marginally: NIFTY closed at 24,055.80, down 24.60 points (-0.10%). Sensex was near-flat, -12.99 at 76,944.28. Intraday it was a third consecutive probe below 24,000 that got bought back: NIFTY opened at 24,077.55 (already below the June cluster top at 24,090), sold to a fresh move low of 23,952.55 - below Aug 31's 23,993.60 and roughly halfway into the 24,090-23,800 cluster - then recovered about 103 points to close at 24,055.80. That is the third session running where an intraday break of 24,000 was defended (Aug 31 low 23,993.60 -> Sep 1 low 23,952.55; closes 24,080.40 -> 24,055.80). Price is grinding in a tight 23,950-24,145 band just under the June cluster top, which has NOT been reclaimed on a closing basis since Aug 28. Daily RSI(14) eased to 42.86 (from 43.70), still above the Aug 18 stretch-low (~40.8) - the higher-RSI-low vs lower-price-low divergence technically persists but is thinning. Drivers: renewed US-Iran tension and Brent above $90/bbl weighed for a second day; bank, auto, realty and healthcare stocks led losses.", "levels": [{"name": "June cluster (top)", "price": 24090, "type": "resistance", "status": "Not reclaimed on a close for the 3rd straight session", "note": "Closes have clustered 24,055-24,080 just below it since Aug 28. A daily close back above is needed to break the grind."}, {"name": "Sep 1 low / sub-24,000 zone", "price": 23952.55, "type": "support", "status": "New move low, bought back ~103 pts into the close", "note": "Below Aug 31's 23,993.60. Third intraday break of 24,000 in a row to be defended. A close below ~23,950 opens the 23,800 cluster bottom with little in between."}, {"name": "June cluster (bottom)", "price": 23800, "type": "support", "status": "Untested", "note": "Next real reference point if the ~23,950 area fails on a closing basis."}, {"name": "S2 (Jun 25 pivot)", "price": 24262, "type": "resistance", "status": "Well overhead, untested", "note": "~205 pts above the close; only briefly reclaimed on Aug 25 before failing."}, {"name": "S1 (Jul 17 pivot)", "price": 24367, "type": "resistance", "status": "Distant, untested", "note": "Touched and rejected Aug 26; not in play."}, {"name": "200-day SMA", "price": 24636.34, "type": "resistance", "status": "Price ~-2.4% below (true 200-DMA)", "note": "200-period simple MA of daily close, computed from 200 daily bars. Deep overhead - not a near-term factor."}], "watchTomorrow": ["24,090 (June cluster top) has not been reclaimed on a close since Aug 28 - three sessions of closes stuck at 24,055-24,080 just below it. A daily close above it is the first real bullish signal.", "23,952.55 (Sep 1 low) then 23,800 (cluster bottom) - successive lower intraday lows are being bought back; a close below ~23,950 opens 23,800 with little support in between.", "Daily RSI (42.86) is easing toward the Aug 18 low (~40.8). Watch whether a lower price low finally drags RSI under 40 and kills the bullish divergence.", "Pattern check: three straight intraday dips below 24,000 have all been recovered. Watch whether buyers show up a fourth time or the 23,800 zone gets tested.", "Crude / US-Iran headlines remain the swing factor into a heavy US data week - ADP (Sep 2), ISM Services (Sep 3), US non-farm payrolls (Sep 5)."], "tomorrowLevels": [{"name": "S1 - Jul 17 pivot", "price": 24367, "type": "resistance", "action": "Downtrend-break trigger", "note": "A close above here would seriously challenge the down-structure; distant."}, {"name": "S2 - Jun 25 pivot", "price": 24262, "type": "resistance", "action": "First reclaim trigger for a bounce case", "note": "Needs a decisive close above to revive the Aug 25 breakout narrative."}, {"name": "Aug 28 close", "price": 24175.65, "type": "resistance", "action": "Bounce-neutralisation level", "note": "Reclaiming the last green close would undo the recent grind lower."}, {"name": "Sep 1 high", "price": 24143.15, "type": "resistance", "action": "Near-term breakout trigger", "note": "First level a recovery must clear before the cluster top comes into play."}, {"name": "June cluster top", "price": 24090, "type": "resistance", "action": "Primary reclaim trigger - 3 closes now stuck just below it", "note": "A daily close above it is the first real bullish signal since Aug 28."}, {"name": "Sep 1 low / 24,000", "price": 23952.55, "type": "support", "action": "Line in the sand", "note": "A decisive close below this points at 23,800."}, {"name": "June cluster bottom", "price": 23800, "type": "support", "action": "Next real support if ~23,950 fails on a close", "note": "The deeper reference point once the lower half of the cluster is in play."}], "newsEvents": [{"category": "Fri, Sep 4", "text": "US August non-farm payrolls + unemployment rate - the week's main event for global rate-cut odds and EM risk appetite.", "source": "Trading Economics; FXStreet"}, {"category": "Ongoing risk", "text": "US-Iran tension keeping Brent above $90/bbl has driven two straight risk-off sessions in Indian equities; escalation/de-escalation in crude is the swing factor. FII selling is the persistent drag.", "source": "India TV News; Goodreturns"}], "notes": "Finalised after the 15:30 IST close. The Aug 28 (Fri) entry has since been backfilled, so prevClose (24,080.40 = Aug 31) is now continuous. sma200 (~24,637) is extrapolated from the downtrend in the 200-day average, not read directly. Structural read: a third straight session with an intraday probe below 24,000 bought back into the close (Aug 31 low 23,993.60 -> Sep 1 low 23,952.55; closes 24,080 -> 24,056). Price is grinding in a tight band just under the June cluster top (24,090), which has not been reclaimed on a close since Aug 28. Daily RSI easing (43.70 -> 42.86) and the bullish divergence is thinning. Drivers today: a second US-Iran / crude-driven risk-off day; bank, auto, realty, healthcare weak; top Nifty losers Shriram Finance, Maruti Suzuki, InterGlobe Aviation (IndiGo). Calendar ahead is in newsEvents - the heavy US data week (ADP Sep 2, ISM Services Sep 3, non-farm payrolls Sep 5) plus the live crude/Iran risk are the next catalysts. A fourth failed defense of ~23,950 opens the 23,800 lower cluster boundary.", "tradePlan": {"for": "2026-09-02", "lots": 3, "qty": 195, "instrument": "ATM weekly options (buy CE / PE)", "context": "Position is BUYING ATM weekly options - CE for the long setups, PE for the short setups. ATM is ~0.5 delta, so a 50-pt index move is only ~25-30 pts of premium; theta bleeds premium through the day, worst on range days and into Friday's NFP. NIFTY has ground under 24,090 for three sessions with three sub-24,000 dips all bought back - a genuine range, the worst backdrop for option buyers both ways. Be selective: one clean directional move, book fast, hard time stop. Assumed ATM premium ~120 pts (India VIX elevated on the Iran risk - could be 140-170). All numbers below are in NIFTY / premium points. Check GIFT Nifty (08:45-09:00 IST) and Brent first.", "setups": [{"name": "A - Long the floor (buy ATM CE)", "bias": "long", "priority": "Base case - 4th defense of sub-24,000", "trigger": "Dip into 23,960-24,000, then a 15-min reversal candle holding above 23,952. Buy the strike nearest spot.", "entry": "CE at NIFTY ~23,990", "stop": "Exit if premium -30% OR NIFTY 15-min < 23,935 - whichever first", "stopPoints": 30, "risk": "~30 premium pts (~55 index pts)", "targets": "T1 NIFTY 24,075 (~+40 premium pts) - book 2 lots. T2 24,143 (~+80 premium pts) on the runner, SL to breakeven.", "entryTime": "~09:45-10:45 IST", "exitTime": "T1 in ~30-75 min; trail runner; square off by 15:15 IST"}, {"name": "B - Short the top (buy ATM PE)", "bias": "short", "priority": "Rejection back under the cap", "trigger": "Push to 24,120-24,145, stalls, 15-min reversal candle back below 24,090. Buy PE nearest spot.", "entry": "PE at NIFTY ~24,115", "stop": "Exit if premium -30% OR NIFTY 15-min > 24,178 - whichever first", "stopPoints": 30, "risk": "~30 premium pts (~63 index pts)", "targets": "T1 NIFTY 24,020 (~+45 premium pts) - book 2 lots. T2 23,960 on the runner, SL to breakeven.", "entryTime": "~09:50-10:45 or ~13:30-14:15 IST", "exitTime": "T1 in ~30-75 min; square off by 15:15 IST"}, {"name": "C - Breakout (buy ATM CE)", "bias": "long", "priority": "Lower priority - theta risk, only on a strong move", "trigger": "Decisive 15-min candle CLOSE above 24,143 on expanding range/volume. Enter on that candle's close, NOT a slow retest.", "entry": "CE at NIFTY ~24,150", "stop": "Exit if premium -30% OR NIFTY back < 24,088", "stopPoints": 35, "risk": "~35 premium pts (~62 index pts)", "targets": "T1 NIFTY 24,262 (S2) - book 2 lots. T2 24,367 (S1) on the runner.", "entryTime": "~09:45-10:30 or ~13:30-14:15 IST, on the breakout candle", "exitTime": "T1 same session; square off by 15:15 IST"}, {"name": "D - Breakdown (buy ATM PE)", "bias": "short", "priority": "Range-floor failure", "trigger": "Decisive 15-min CLOSE below 23,950 (Sep 1 low / line in the sand). Enter on the close.", "entry": "PE at NIFTY ~23,940", "stop": "Exit if premium -30% OR NIFTY back > 24,012", "stopPoints": 35, "risk": "~35 premium pts (~72 index pts)", "targets": "T1 NIFTY 23,860 - book 2 lots. T2 23,800 (cluster bottom) on the runner.", "entryTime": "~09:45-10:45 or ~14:00-14:30 IST, on the break candle", "exitTime": "T1 in ~30-75 min; square off by 15:15 IST"}], "timing": ["Do NOT buy in the first 20-25 min (09:15-09:40) - post-open IV crush hurts fresh option longs even if direction is right.", "Best window 09:45-11:00 for the first clean move; a second window 13:15-14:30. Nothing fresh after ~14:30.", "Avoid the 11:30-13:00 lull entirely - flat price + theta = guaranteed bleed on a long option.", "Hard TIME STOP: if the trade hasn't moved your way within ~30 min, exit regardless of the price stop.", "Stand aside if the gap is > ~+/-0.5% (IV spike - let it settle 30-45 min) or if price just coils 25-30 pts around 24,090 (range day = option buyers lose both ways).", "Square off ALL intraday positions by 15:15 IST - before the closing auction (option premium bleeds on last-15-min theta + slippage). No new entries after 14:30."], "sizingNote": "195 qty across 3 lots - work in points only. Risk per trade ~30-35 premium pts; T1 ~+40-45 premium pts; T2 ~+80 premium pts. Scale OUT, not in: 2 lots off at T1, trail the 3rd with SL at breakeven premium. Never average down a losing long option. If India VIX is high, prefer setups A/B/D over C and trim targets - fatter premium means a bigger adverse premium swing for the same index stop.", "disclaimer": "Level-based scenarios for BUYING ATM options, not investment advice. Wait for the stated trigger; premium stops and the time stop are mandatory; confirm with live price, IV and your own risk limits."}, "cpr": {"width": 13, "label": "ultra-narrow (trend-day signal)", "range": "24,061.15-24,073.98", "basis": "from 2026-08-31 H/L/C"}}, {"date": "2026-09-02", "symbol": "NSE:NIFTY", "close": 23914.45, "change": -141.35, "changePct": -0.59, "open": 23858.0, "dayHigh": 23914.45, "dayLow": 23786.8, "dayLowTime": "intraday (opening hour)", "prevClose": 24055.8, "rsi14": 41.0, "sma200": 24626.53, "giftPremarketHigh": null, "giftPremarketTime": null, "summary": "FINALISED - backfilled on Sep 3 (this session was not logged live). A gap-down capitulation that then recovered hard. NIFTY opened at 23,858 (a ~198-pt gap below Sep 1's close) as Brent crude spiked to ~$95/bbl on further US-Iran escalation, sold to a low of 23,786.8 - a marginal (~13-pt) break BELOW the 23,800 bottom of the June support cluster, meaning the entire 24,090-23,800 band has now been traversed - then climbed all session to close at 23,914.45, exactly the day's high, a ~128-pt recovery off the low. Still down 141.35 pts (-0.59%); Sensex -374 at 76,570. This is the fourth 'probe below support, close back above' in the sequence (Aug 19 at the cluster, Aug 31 at 24,000, Sep 1 at 23,950, Sep 2 at 23,800) - each defense at a lower level, a stair-step down, but intraday buyers keep turning up, and today's close-at-the-high with a long lower wick is the most constructive intraday signature since the Aug 20 reversal. Offsetting that: daily RSI(14) is back around 41 (live 42.22 includes the Sep 3 open tick; Sep 2 close ~40.5-41.5) - essentially at the Aug 18 stretch-low (~40.8) but now on a price ~230 pts lower, so the earlier bullish RSI divergence has largely closed - momentum is confirming the lower low rather than diverging from it.", "levels": [{"name": "June cluster (bottom)", "price": 23800, "type": "support", "status": "Breached ~13 pts intraday (low 23,786.8), reclaimed on the close", "note": "The whole 24,090-23,800 June band has now been traversed. 4th successive defense at a lower level (Aug 19 / Aug 31 / Sep 1 / Sep 2). A daily CLOSE below 23,800 would be the first genuine break of the entire band."}, {"name": "Sep 2 low", "price": 23786.8, "type": "support", "status": "Session low, ~128-pt recovery into a close at the day's high", "note": "The line that now matters most. A close below it opens the next major shelf at ~23,600 (23,555-23,620), then ~23,430."}, {"name": "Sep 2 close / day high", "price": 23914.45, "type": "support", "status": "Closed at the high - immediate pivot", "note": "Holding above this on Sep 3 keeps the recovery alive; losing it re-exposes 23,800."}, {"name": "Sep 1 low", "price": 23952.55, "type": "resistance", "status": "First hurdle for the bounce", "note": "Sep 3 has gapped up to open near here (~23,998). A 15-min close above it is the first sign the bounce has legs."}, {"name": "June cluster (top)", "price": 24090, "type": "resistance", "status": "Not reclaimed on a close since Aug 28 - now ~175 pts overhead", "note": "The cap on every rally attempt for two weeks."}, {"name": "S2 (Jun 25 pivot)", "price": 24262, "type": "resistance", "status": "Far overhead, untested", "note": "Only briefly reclaimed Aug 25 before failing."}, {"name": "200-day SMA", "price": 24626.53, "type": "resistance", "status": "Price ~-2.9% below (true 200-DMA)", "note": "200-period simple MA of daily close, computed from 200 daily bars. Deep overhead - not a near-term factor."}], "watchTomorrow": ["Sep 3 has gapped UP to open ~23,998 (+83). First test: does it hold above Sep 2's close/high (23,914) and reclaim Sep 1's low (23,952.55) on a 15-min close - or fade back below 23,900 and keep the stair-step-down intact?", "23,786.8 (Sep 2 low) / 23,800 is now THE line. A daily close below it is the first true break of the entire June support band (24,090-23,800) and opens the next major shelf at ~23,600 (23,555-23,620), then ~23,430.", "Daily RSI ~41 is back at the Aug 18 low on a much lower price - the bullish divergence has largely closed. Watch whether two green closes rebuild it or a lower low drags RSI under 40.", "Brent at ~$95 on US-Iran escalation is the dominant driver: a de-escalation headline could spark a sharp short-covering bounce; further escalation opens ~23,600 then ~23,430. Bond yields spiking is a second headwind (auto, IT lagged today).", "Heavy US data: ISM Services (Sep 3), then US August non-farm payrolls Fri Sep 4 - the afternoon of Sep 3 and all of Sep 4 are likely compressed / headline-driven."], "tomorrowLevels": [{"name": "S2 - Jun 25 pivot", "price": 24262, "type": "resistance", "action": "First reclaim trigger for a real bounce", "note": "Needs a decisive close above to change the structure."}, {"name": "Sep 1 high", "price": 24143.15, "type": "resistance", "action": "Bounce-extension trigger", "note": "Above here the move toward S2 opens up."}, {"name": "June cluster top", "price": 24090, "type": "resistance", "action": "Primary reclaim trigger - not closed above since Aug 28", "note": "A daily close above it is the first real bullish signal in two weeks."}, {"name": "Sep 1 low", "price": 23952.55, "type": "resistance", "action": "First hurdle - near the Sep 3 gap-up open", "note": "A 15-min close above it is the first sign the bounce has legs."}, {"name": "Sep 2 close / high", "price": 23914.45, "type": "support", "action": "Bounce-support - hold above to keep the recovery alive", "note": "A slip back below it re-exposes 23,800."}, {"name": "Sep 2 low / cluster bottom", "price": 23800, "type": "support", "action": "Critical line - a close below = full breakdown of the June band", "note": "Low of 23,786.8 already probed just below."}, {"name": "Next major support shelf", "price": 23600, "type": "support", "action": "Downside target if 23,800 breaks on a close", "note": "23,555-23,620 saw 8+ touches in May-June - the real next support, not a projection. ~23,430 below that."}], "newsEvents": [{"category": "Fri, Sep 4", "text": "US August non-farm payrolls (~18:00 IST) + unemployment rate - the week's main event for global rate-cut odds; the Indian reaction lands Monday Sep 7.", "source": "Trading Economics; MQL5"}, {"category": "Ongoing risk", "text": "Brent ~$95/bbl on US-Iran escalation is the dominant driver - India imports ~85% of its crude, so higher oil hits inflation, the INR, the import bill and corporate margins. FII selling continues.", "source": "Business Standard; Equentis"}], "notes": "Backfilled on Sep 3; Sep 2 was not logged live. OHLC and volume (~319M) are final from the daily feed. rsi14 (~41) is approximate - the live daily reading (42.22) includes the Sep 3 opening tick (gap up to 23,997.95); the Sep 2 CLOSE reading is ~40.5-41.5. sma200 (~24,625) is extrapolated, not read. Structural read: the June support cluster (24,090-23,800) has now been fully traversed - Sep 2 probed ~13 pts below the 23,800 floor and closed back inside at the day's high (23,914.45), the fourth lower-level intraday defense in the sequence. Constructive price action (close at the high, long lower wick) but momentum has caught down (RSI ~41, back at the Aug 18 low on a much lower price). Drivers: Brent spiked to ~$95 on US-Iran escalation; bond yields up; auto and IT lagged; Sensex -374 at 76,570. The line that decides the next leg is 23,800 on a CLOSING basis - below it, ~23,600 then ~23,430; a de-escalation headline or a hold above Sep 1's low (23,952.55) keeps the bounce alive toward the 24,090 cap.", "tradePlan": {"for": "2026-09-03", "lots": 3, "qty": 195, "instrument": "ATM weekly options (buy CE / PE)", "context": "Sep 3 gapped UP ~+83 to ~23,998 after Sep 2's capitulation-and-recovery (low 23,786.8, closed at the day's high 23,914.45). The whole June band (24,090-23,800) has been traversed. Close-at-high plus a long lower wick favour a bounce attempt, but it runs straight into 23,952 then the 24,090 cap, with Brent at ~$95 and US jobs data Friday keeping the tape choppy - a bad backdrop for option BUYERS. Be selective, one clean move, book fast, hard time stop. Assumed ATM premium ~130-150 pts (India VIX elevated on the crude spike). All numbers in NIFTY / premium points. Note the confluence: R3 pivot 24,085 sits on the 24,090 cap; R1 pivot 23,957 sits on the Sep 1 low 23,952; the CPR (23,851-23,893) brackets Sep 2's close. Check GIFT Nifty (08:45-09:00 IST) and Brent first - a big crude move either way overrides the levels.", "setups": [{"name": "A - Long the reclaim (buy ATM CE)", "bias": "long", "priority": "Base case if the gap holds", "trigger": "Price holds above ~23,915 (Sep 2 close) and posts a 15-min CLOSE above 23,952-23,957 (Sep 1 low = R1 pivot, confluence). Buy the strike nearest spot.", "entryTime": "~09:45-10:45 IST", "exitTime": "T1 in ~30-75 min; trail runner; square off by 15:15 IST", "entry": "CE at NIFTY ~23,960", "stop": "Exit if premium -30% OR NIFTY 15-min < 23,900 - whichever first", "stopPoints": 35, "risk": "~35 premium pts (~60 index pts)", "targets": "T1 NIFTY 24,020 (~+40 premium pts) - book 2 lots. T2 24,090 (the cap) on the runner, SL to breakeven."}, {"name": "B - Gap-fill fade (buy ATM PE)", "bias": "short", "priority": "Opening strength that fails", "trigger": "Gap-up push into 23,950-24,010, stalls, then a 15-min reversal candle back below 23,915. Buy PE nearest spot.", "entryTime": "~09:50-10:45 IST", "exitTime": "T1 in ~30-75 min; square off by 15:15 IST", "entry": "PE at NIFTY ~23,955", "stop": "Exit if premium -30% OR NIFTY 15-min > 24,015", "stopPoints": 35, "risk": "~35 premium pts (~60 index pts)", "targets": "T1 NIFTY 23,860 (~+45 premium pts) - book 2 lots. T2 23,800 on the runner."}, {"name": "C - Breakout the cap (buy ATM CE)", "bias": "long", "priority": "Lower priority - only on a decisive move", "trigger": "15-min candle CLOSE above 24,085-24,090 (the cap = R3 pivot, confluence) on expanding range - the first close above the cap since Aug 28. Enter on that candle.", "entryTime": "~09:45-11:00 or ~13:15-14:15 IST", "exitTime": "T1 same session; square off by 15:15 IST", "entry": "CE at NIFTY ~24,095", "stop": "Exit if premium -30% OR NIFTY back < 24,040", "stopPoints": 40, "risk": "~40 premium pts (~55 index pts)", "targets": "T1 NIFTY 24,143 (Sep 1 high) - book 2 lots. T2 24,262 (S2) on the runner."}, {"name": "D - Breakdown short (buy ATM PE)", "bias": "short", "priority": "The June band finally breaks", "trigger": "15-min candle CLOSE below 23,800 (below Sep 2's 23,786.8 low). Enter on the close.", "entryTime": "~09:45-10:45 or ~14:00-14:30 IST", "exitTime": "T1 in ~30-75 min; square off by 15:15 IST", "entry": "PE at NIFTY ~23,790", "stop": "Exit if premium -30% OR NIFTY back > 23,865 (back inside the range)", "stopPoints": 40, "risk": "~40 premium pts (~75 index pts)", "targets": "T1 NIFTY 23,744 (pivot S2) / ~23,702 (pivot S3) - book 2 lots. T2 23,600 (the 23,555-23,620 shelf, 8+ touches May-June) on the runner."}], "timing": ["Do NOT buy in the first 20-25 min (09:15-09:40) - post-open IV crush hurts fresh option longs even if direction is right; a gap day makes this worse.", "Best window 09:45-11:00 for the first clean move; a second window 13:15-14:30. Nothing fresh after ~14:30.", "Avoid the 11:30-13:00 lull entirely - flat price + theta = guaranteed bleed on a long option.", "Hard TIME STOP: if the trade hasn't moved your way within ~30 min, exit regardless of the price stop.", "US jobs data is tomorrow (Fri, Sep 4) - the Sep 3 afternoon will likely compress; do not carry a fresh position into the last hour.", "Square off ALL intraday positions by 15:15 IST - before the closing auction. Stand aside if Brent gaps sharply either way at the open (let it settle 30-45 min) or if price just coils 25-30 pts around 23,950."], "sizingNote": "195 qty across 3 lots - work in points only. Risk per trade ~35-40 premium pts; T1 ~+40-45 premium pts; T2 ~+80. Scale OUT, not in: 2 lots off at T1, trail the 3rd with SL at breakeven premium. Never average down a losing long option. VIX is elevated on the crude spike, so premiums are fat - a range day bleeds buyers both ways; prefer setups A/B (clear reclaim or fade) and keep targets modest unless C or D triggers on real momentum.", "disclaimer": "Level-based scenarios for BUYING ATM options, not investment advice. Wait for the stated trigger; premium stops and the time stop are mandatory; confirm with live price, IV and your own risk limits.", "pivots": {"basis": "standard formula on Sep 2 H/L/C = 23,914.45 / 23,786.80 / 23,914.45", "pdh": 23914.45, "pdl": 23786.8, "cpr": "23,850.6 (BC) - 23,871.9 (pivot) - 23,893.2 (TC); ~43 pts wide = narrow -> expansion / trend-day bias", "r": "R1 23,957 - R2 24,000 - R3 24,085", "s": "S1 23,829 - S2 23,744 - S3 23,702"}}, "cpr": {"width": 5, "label": "ultra-narrow (trend-day signal)", "range": "24,047.85-24,053.15", "basis": "from 2026-09-01 H/L/C"}}, {"date": "2026-09-03", "symbol": "NSE:NIFTY", "close": 23873.45, "change": -41.0, "changePct": -0.17, "open": 23997.95, "dayHigh": 24025.4, "dayLow": 23873.45, "dayLowTime": "close (no recovery)", "prevClose": 23914.45, "rsi14": 37.11, "sma200": 24616.51, "giftPremarketHigh": null, "giftPremarketTime": null, "summary": "FINALISED (session closed 15:30 IST). A small red close that was much weaker than the -41 pts (-0.17%) suggests. NIFTY gapped UP to 23,997.95, pushed to a high of 24,025.40 - failing well below the 24,090 cap and unable to hold above Sep 1's low (23,952) on any 15-min close - then sold off through the entire session to finish at 23,873.45, exactly the day's low. Sensex -417 at 76,152. Structurally it was a higher-high / higher-low day vs Sep 2, but the close at the low, below Sep 2's close and below the day's CPR, is a distribution signature. The major 23,785-23,835 support was NOT tested today (low 23,873) - it stays intact, now defended on a closing basis five sessions running. Price is coiling ~23,785-24,025 just under the broken 24,090 shelf. The key negative is momentum: daily RSI(14) fell to 37.11 - a clean break below the Aug 18 stretch-low (~40.8) - so momentum is now confirming the downtrend, roughly 7 points from oversold. Volume (239M) was below the ~294M average, so no heavy distribution, but the tape is one-directional. Drivers: crude steadied (Brent ~$95, no fresh spike) so there was no new catalyst - the market faded on its own weight and sector rotation; private banks and realty outperformed while consumer, auto and tech sold off (Titan and Trent the top Nifty losers).", "levels": [{"name": "June cluster (bottom) / major support", "price": 23800, "type": "support", "status": "Not tested today (low 23,873) - intact, 5th straight close above it", "note": "The 23,785-23,835 zone (10+ touches Apr-Sep; user's 23,805 line; Sep 2 low 23,786.8). A daily CLOSE below it is the first genuine break of the June band and opens ~23,600."}, {"name": "Sep 3 close / day low", "price": 23873.45, "type": "support", "status": "Closed at the low - immediate weak point", "note": "Sits in the minor 23,865-23,915 shelf, just above the major zone. A gap below it Friday puts 23,800 straight in play."}, {"name": "Sep 3 high", "price": 24025.4, "type": "resistance", "status": "Gap-up failed here, then sold off all day", "note": "The near-term cap; a 15-min close above it is the first sign the fade has exhausted."}, {"name": "Sep 1 low", "price": 23952.55, "type": "resistance", "status": "Held as resistance on a closing basis today", "note": "= R1 pivot 23,957. First hurdle for any bounce."}, {"name": "June cluster (top)", "price": 24090, "type": "resistance", "status": "Not reclaimed on a close since Aug 28 - ~215 pts overhead", "note": "The two-week cap; = Sep 4 R2 pivot (24,076) confluence."}, {"name": "Next major support shelf", "price": 23600, "type": "support", "status": "Untested - the real level below 23,800", "note": "23,555-23,620 saw 8+ touches in May-June. ~23,430 and the ~23,070 floor are below."}, {"name": "200-day SMA", "price": 24616.51, "type": "resistance", "status": "Price ~-3.0% below (true 200-DMA)", "note": "200-period simple MA of daily close, computed from 200 daily bars. Deep overhead - not a near-term factor."}], "watchTomorrow": ["Sep 3 closed at its low (23,873.45) below the day's CPR - the bias into Friday is down. First tell: does Friday open hold above 23,873 and reclaim the CPR (23,899-23,949), or gap/trade straight for the 23,785-23,835 major support?", "23,785-23,835 is now THE line - defended on a closing basis five sessions running. A daily close below it (below Sep 2's 23,786.8 low) is the first true break of the June band and opens ~23,600, then ~23,430.", "Daily RSI 37.11 has broken below the Aug 18 low (~40.8) - momentum now confirms the downtrend. ~7 points from oversold (30); a capitulation flush toward 23,600 could get there.", "Friday IS NFP day: the US August jobs report lands ~18:00 IST, AFTER the NSE close, so the Indian session is a low-conviction, position-squaring day - the real move is Monday Sep 7's gap. Brent ~$95 held steady today; a weekend escalation or de-escalation is the swing factor.", "A reclaim of 23,952 (Sep 1 low / R1 pivot) then 24,025 (Sep 3 high) on 15-min closes is what a genuine bounce needs; below that it is a bear-flag grind."], "tomorrowLevels": [{"name": "June cluster top", "price": 24090, "type": "resistance", "action": "Primary reclaim trigger - not closed above since Aug 28", "note": "= Sep 4 R2 pivot (24,076). A daily close above is the first real bullish signal in two weeks."}, {"name": "Sep 3 high", "price": 24025.4, "type": "resistance", "action": "Fade-exhaustion trigger", "note": "A 15-min close above it says the sell-off has paused."}, {"name": "Sep 1 low / R1 pivot", "price": 23952.55, "type": "resistance", "action": "First hurdle for a bounce", "note": "Held as resistance on a closing basis today."}, {"name": "CPR (Sep 4)", "price": 23924, "type": "resistance", "action": "Bias line - price closed below it, so it caps rallies", "note": "CPR band 23,899-23,949; pivot 23,924. Reclaiming it flips the intraday bias neutral."}, {"name": "Sep 3 close / low", "price": 23873.45, "type": "support", "action": "Immediate weak point", "note": "A gap or break below puts the major zone straight in play."}, {"name": "23,785-23,835 major support", "price": 23800, "type": "support", "action": "Critical line - a close below = full breakdown of the June band", "note": "Defended on a closing basis 5 sessions running (Aug 19 / 31 / Sep 1 / 2 / 3)."}, {"name": "Next major support shelf", "price": 23600, "type": "support", "action": "Downside target if 23,800 breaks on a close", "note": "23,555-23,620, 8+ touches May-June; ~23,430 below."}], "newsEvents": [{"category": "Fri, Sep 4", "text": "US August non-farm payrolls (~18:00 IST) plus the unemployment rate - the week's main event, but AFTER the NSE close, so the Indian reaction lands on Monday Sep 7. India: RBI weekly forex reserves (Friday evening).", "source": "Trading Economics; MQL5"}, {"category": "Mon, Sep 7", "text": "NSE reacts to Friday's US jobs report plus any weekend crude / US-Iran headlines - the main gap-risk event for positions carried over.", "source": "-"}, {"category": "Ongoing risk", "text": "Brent ~$95/bbl held steady on Sep 3 (no fresh spike) but stays elevated on US-Iran tension; US 10-year yields remain high. Escalation targets ~23,600; a de-escalation headline is a sharp short-covering risk.", "source": "India TV News; Business Standard"}, {"category": "Mid-month", "text": "India August CPI is due around Sep 12; the RBI MPC decision is early October - neither is this week.", "source": "-"}], "notes": "Finalised after the 15:30 IST close. rsi14 (37.11) is the actual Sep 3 close reading. sma200 is the true 200-period SMA of daily close (computed from 200 daily bars). How Sep 3's plan played out: the 'gap-fill fade' (setup B) was the correct read - the gap-up to 24,025 sold off all session; the 'long the reclaim' (setup A) would have failed, since price never held 23,952-23,957 on a 15-min close. Structural read: a failed gap-up and a close at the low (23,873.45), below Sep 2's close and below the CPR, with daily RSI breaking under the Aug 18 low to 37 - momentum has turned decisively down. The 23,785-23,835 major support (intact, 5 straight closes above) is the line that decides the next leg: a close below opens ~23,600 then ~23,430; a reclaim of 23,952 then 24,025 is what a bounce needs. Friday is a low-conviction NFP-eve session for Indian equities - the real move is Monday's gap. Drivers: crude steadied (~$95, no fresh spike), market faded on sector rotation - private banks / realty firm, consumer / auto / tech weak (Titan, Trent top losers); Sensex -417 at 76,152.", "tradePlan": {"for": "2026-09-04", "lots": 3, "qty": 195, "instrument": "ATM weekly options (buy CE / PE)", "context": "Sep 3 failed the gap-up and closed at its low (23,873.45) - below Sep 2's close and below the day's CPR - with daily RSI breaking under the Aug 18 low to 37. Momentum is decisively down. Price coils between the intact 23,785-23,835 major support and 24,025 / 24,090 resistance. Friday IS NFP day: the number hits ~18:00 IST AFTER the NSE close, so the Indian session is a low-conviction, position-squaring day with big Monday gap risk. For option BUYERS that means theta plus a likely tight range - keep it small, fast, and do NOT carry a position over the weekend. Assumed ATM premium ~120-140 pts (VIX still elevated on crude). All numbers in NIFTY / premium points. Confluence: R1 pivot 23,957 sits on the Sep 1 low 23,952; R2 pivot 24,076 sits under the 24,090 cap; price closed below the whole CPR (23,899-23,949) so the CPR caps rallies. Check GIFT Nifty and Brent first.", "pivots": {"basis": "standard formula on Sep 3 H/L/C = 24,025.40 / 23,873.45 / 23,873.45 (close = low)", "pdh": 24025.4, "pdl": 23873.45, "cpr": "23,898.8 (TC) - 23,924.1 (pivot) - 23,949.4 (BC); ~51 pts wide; price CLOSED BELOW the whole band = bearish bias, CPR is overhead resistance", "r": "R1 23,975 - R2 24,076 - R3 24,127", "s": "S1 23,823 - S2 23,772 - S3 23,671"}, "setups": [{"name": "A - Long the major support (buy ATM CE)", "bias": "long", "priority": "Only real long - 6th defense of 23,785-23,835", "trigger": "Dip into 23,800-23,835, then a 15-min reversal candle holding above 23,785 (~S2 pivot 23,772). Buy the strike nearest spot.", "entryTime": "~09:45-10:45 IST", "exitTime": "T1 in ~30-75 min; trail runner; square off by 15:15 IST", "entry": "CE at NIFTY ~23,825", "stop": "Exit if premium -30% OR NIFTY 15-min < 23,770 - whichever first", "stopPoints": 35, "risk": "~35 premium pts (~60 index pts)", "targets": "T1 NIFTY 23,924 (pivot) - book 2 lots. T2 23,975 (R1) / CPR underside 23,899 on the runner, SL to breakeven."}, {"name": "B - Fade the CPR (buy ATM PE)", "bias": "short", "priority": "Base case - price closed below the CPR", "trigger": "Bounce into 23,899-23,950 (CPR / pivot / R1), stalls, then a 15-min reversal candle back below 23,873. Buy PE nearest spot.", "entryTime": "~09:50-11:00 IST", "exitTime": "T1 in ~30-75 min; square off by 15:15 IST", "entry": "PE at NIFTY ~23,930", "stop": "Exit if premium -30% OR NIFTY 15-min > 23,980 (above R1)", "stopPoints": 35, "risk": "~35 premium pts (~55 index pts)", "targets": "T1 NIFTY 23,823 (S1) - book 2 lots. T2 23,772 (S2) then ~23,700 on the runner."}, {"name": "C - Breakout long (buy ATM CE)", "bias": "long", "priority": "Low priority on NFP-eve - only on a decisive move", "trigger": "15-min candle CLOSE above 24,025 (Sep 3 high) on expanding range. Enter on that candle.", "entryTime": "~09:45-11:00 IST", "exitTime": "T1 same session; square off by 15:15 IST", "entry": "CE at NIFTY ~24,030", "stop": "Exit if premium -30% OR NIFTY back < 23,975 (R1)", "stopPoints": 40, "risk": "~40 premium pts (~55 index pts)", "targets": "T1 NIFTY 24,076 (R2) - book 2 lots. T2 24,090 (the cap) / 24,127 (R3) on the runner."}, {"name": "D - Breakdown short (buy ATM PE)", "bias": "short", "priority": "The 5-session defense of 23,800 finally fails", "trigger": "15-min candle CLOSE below 23,785 (below the major zone / Sep 2 low; ~S2 pivot 23,772). Enter on the close.", "entryTime": "~09:45-10:45 or ~14:00-14:30 IST", "exitTime": "T1 in ~30-75 min; square off by 15:15 IST", "entry": "PE at NIFTY ~23,775", "stop": "Exit if premium -30% OR NIFTY back > 23,840", "stopPoints": 40, "risk": "~40 premium pts (~65 index pts)", "targets": "T1 NIFTY 23,671 (S3 pivot) - book 2 lots. T2 23,600 (23,555-23,620 shelf) on the runner."}], "timing": ["Do NOT buy in the first 20-25 min (09:15-09:40) - post-open IV crush hurts fresh option longs even if direction is right.", "Best window 09:45-11:00 for the first clean move; a second window 13:15-14:00 only. Nothing fresh after ~14:00 on Friday - the session is thin and position-squaring ahead of NFP.", "Avoid the 11:30-13:00 lull entirely - flat price + theta = guaranteed bleed on a long option.", "Hard TIME STOP: if the trade hasn't moved your way within ~30 min, exit regardless of the price stop.", "NFP lands tonight ~18:00 IST and Brent / US-Iran headlines run all weekend - square off EVERYTHING by 15:15 IST and do NOT carry a position over the weekend; Monday Sep 7 can gap 150+ pts either way.", "Stand aside if GIFT Nifty / Brent gap sharply at the open (let it settle 30-45 min) or if price just coils 25-30 pts around 23,900 (range day = option buyers lose both ways)."], "sizingNote": "195 qty across 3 lots - work in points only. Risk per trade ~35-40 premium pts; T1 ~+40-45 premium pts; T2 ~+80. Scale OUT, not in: 2 lots off at T1, trail the 3rd with SL at breakeven premium. Never average down a losing long option. On an NFP-eve Friday, expect a smaller range - prefer setups A/B (defined level reaction) and take T1 quickly; only let a runner breathe if C or D triggers on real momentum.", "disclaimer": "Level-based scenarios for BUYING ATM options, not investment advice. Wait for the stated trigger; premium stops and the time stop are mandatory; do not hold over the weekend; confirm with live price, IV and your own risk limits."}, "cpr": {"width": 43, "label": "moderate", "range": "23,850.62-23,893.17", "basis": "from 2026-09-02 H/L/C"}}, {"date": "2026-09-04", "symbol": "NSE:NIFTY", "close": 23897.7, "change": 24.25, "changePct": 0.1, "open": 23910.9, "dayHigh": 24005.75, "dayLow": 23895.85, "dayLowTime": "intraday", "prevClose": 23873.45, "rsi14": 38.1, "sma200": 24606.44, "giftPremarketHigh": null, "giftPremarketTime": null, "summary": "FINALISED - backfilled on Sep 7 (this session was not logged live). A quiet, low-conviction NFP-eve day. NIFTY opened at 23,910.90, traded a tight ~110-pt range (23,895.85-24,005.75) and closed at 23,897.70, up 24.25 pts (+0.10%) - the first back-to-back non-negative closes since Aug 28, but on thin volume with everyone waiting for the US jobs report. The 23,785-23,835 major support was not tested (low 23,896); the day was capped at 24,006, still below the 24,025 Sep 3 high and far below the 24,090 cap. Daily RSI ~38.1 - still below the Aug 18 stretch-low. AFTER the NSE close the US August payrolls printed HOT: 162,000 jobs vs ~55k expected (most in five months), unemployment steady at 4.1%, with +55k of upward revisions to June/July. A hawkish surprise that trimmed Fed rate-cut odds - and over the weekend fresh US-Iran attacks pushed Brent toward $97 - which together set up Monday's (Sep 7) gap-down and the break of the June support band.", "levels": [{"name": "23,785-23,835 major support", "price": 23800, "type": "support", "status": "Not tested Sep 4 (low 23,896) - still intact at that point", "note": "10+ touches Apr-Sep; user's 23,805 line. NOTE: broken intraday on Sep 7 (low 23,757.65) - see the Sep 7 entry."}, {"name": "Sep 4 high", "price": 24005.75, "type": "resistance", "status": "Capped here - could not reach the 24,025 Sep 3 high", "note": "Minor near-term resistance inside the broken range."}, {"name": "June cluster (top)", "price": 24090, "type": "resistance", "status": "Not reclaimed on a close since Aug 28", "note": "The two-week cap."}, {"name": "Next major support shelf", "price": 23600, "type": "support", "status": "Untested - the real level below 23,800", "note": "23,555-23,620, 8+ touches May-June. ~23,430 and the ~23,070 floor below."}, {"name": "200-day SMA", "price": 24606.44, "type": "resistance", "status": "Price ~-2.9% below (true 200-DMA)", "note": "200-period simple MA of daily close, computed from 200 daily bars. Deep overhead - not a near-term factor."}], "watchTomorrow": ["US August payrolls came in HOT (162k vs ~55k exp, unemployment 4.1%) - hawkish for rate-cut odds, USD-positive, EM-negative. Combined with Brent near $97 on weekend US-Iran attacks, Monday Sep 7 was set up to gap down.", "23,785-23,835 major support (defended on a closing basis 5 sessions Aug 19-Sep 3) is THE line - a break opens ~23,600, then ~23,430. [Hindsight: Sep 7 gapped down and broke it to 23,757.65.]", "Daily RSI ~38 stayed below the Aug 18 low - momentum still bearish going into the weekend.", "Bigger events ahead: US CPI (Sep 10-11), India CPI (Sep 12), then the FOMC decision (Sep 16-17) - a hot payrolls print lowers the odds of a September cut.", "Brent ~$97 is the dominant swing factor - any de-escalation is a sharp short-covering risk; further escalation targets ~23,600."], "tomorrowLevels": [{"name": "June cluster top", "price": 24090, "type": "resistance", "action": "Primary reclaim trigger - not closed above since Aug 28", "note": "First real bullish signal in two weeks would be a close above."}, {"name": "Sep 3 high", "price": 24025.4, "type": "resistance", "action": "Fade-exhaustion trigger", "note": "Sep 4 could not reclaim it."}, {"name": "Sep 1 low", "price": 23952.55, "type": "resistance", "action": "First hurdle for any bounce", "note": "Has acted as resistance on closes since Sep 2."}, {"name": "23,785-23,835 major support", "price": 23800, "type": "support", "action": "Critical line - a close below = full breakdown of the June band", "note": "5 straight closes above it into Sep 4."}, {"name": "Next major support shelf", "price": 23600, "type": "support", "action": "Downside target if 23,800 breaks on a close", "note": "23,555-23,620, 8+ touches May-June; ~23,430 below."}], "newsEvents": [{"category": "Result - Fri Sep 4", "text": "US August non-farm payrolls: +162,000 (vs ~55k expected, most in 5 months); unemployment steady at 4.1%; June/July revised +55k. A hot print - trims September Fed-cut odds, USD-positive, pressure on emerging markets.", "source": "BLS; UPI; Babypips"}, {"category": "Wed-Thu, Sep 10-11", "text": "US August CPI - the last major inflation read before the FOMC; a hot number would further cut rate-cut hopes.", "source": "Trading Economics"}, {"category": "Fri, Sep 12", "text": "India August CPI inflation - watched for RBI space; elevated crude feeds the inflation risk.", "source": "-"}, {"category": "Tue-Wed, Sep 16-17", "text": "US FOMC rate decision + projections - the hot payrolls print lowers the odds of a September cut; a hawkish hold would pressure EM equities further.", "source": "-"}, {"category": "Ongoing risk", "text": "Brent ~$97/bbl after fresh weekend US-Iran attacks - India imports ~85% of its crude, so this is a direct headwind (inflation, INR, import bill). De-escalation = sharp short-covering risk.", "source": "India TV News; Goodreturns"}], "notes": "Backfilled on Sep 7; Sep 4 was not logged live. OHLC and volume (~231M) are final. rsi14 (~38.1) is derived via Wilder's recursion from the Sep 3 close reading (37.11) - the live daily RSI now reads ~34.5 but that already includes Sep 7's drop. sma200 is the true 200-period SMA of daily close (computed from 200 daily bars). Structural read: a quiet NFP-eve inside day (23,896-24,006, +0.10%) that changed nothing technically - price still capped well below the 24,090 cap, RSI still sub-38. The real story is what came after the bell: a hot US jobs report (162k vs ~55k) plus Brent near $97 on weekend US-Iran attacks, which drove Monday's gap-down and the break of the 23,785-23,835 support band (see the Sep 7 entry). No trade plan on this entry - superseded by Sep 7.", "cpr": {"width": 51, "label": "moderate", "range": "23,898.78-23,949.43", "basis": "from 2026-09-03 H/L/C"}}, {"date": "2026-09-07", "symbol": "NSE:NIFTY", "close": 23779.15, "change": -118.55, "changePct": -0.5, "open": 23883.15, "dayHigh": 23890.0, "dayLow": 23737.9, "dayLowTime": "late session (~15:15 IST)", "prevClose": 23897.7, "rsi14": 34.72, "sma200": 24595.27, "giftPremarketHigh": null, "giftPremarketTime": null, "summary": "FINALISED (session closed). A gap-down and steady sell-off that BROKE the June support band on a closing basis - though only marginally. NIFTY opened at 23,883.15 (a ~15-pt gap below Sep 4) as the hot US jobs report (162k vs ~55k) trimmed Fed-cut odds and Brent held near $97 on fresh US-Iran attacks. Price fell to 23,737.90 late in the session, then recovered ~41 pts to close at 23,779.15, down 118.55 (-0.50%). Sensex -380 at 76,132.81; Nifty IT fell over 2% (the biggest single-sector drag, on Fed / global-growth worries). Technically this is the FIRST close below the 23,785-23,835 major support that held on a closing basis for five straight sessions (Aug 19 through Sep 3) - the close (23,779.15) sits ~6 pts under the zone's base, so it is a marginal break, not decisive: a follow-through close below ~23,750 would confirm it, while a recovery back above 23,835 would make today a bear trap. Below here the next real support is the 23,555-23,620 shelf - a ~120-pt air pocket. Daily RSI(14) is 34.72, near oversold (30) but not there; the down-move is 4 sessions old (Sep 2, 3, 7 red; Sep 4 flat) with momentum firmly bearish.", "levels": [{"name": "23,785-23,835 major support", "price": 23800, "type": "resistance", "status": "BROKEN - first close below it (23,779.15) after 5 defenses", "note": "Held on a closing basis Aug 19-Sep 3. Now overhead resistance. A recovery close back above 23,835 = bear trap; failure to reclaim confirms the break."}, {"name": "Sep 7 low", "price": 23737.9, "type": "support", "status": "New swing low of the down-move", "note": "No prior structure here - just the current extreme. A close below ~23,750 (near S1 pivot 23,715) confirms continuation toward 23,600."}, {"name": "Next major support shelf", "price": 23600, "type": "support", "status": "Untested - the real level below", "note": "23,555-23,620, 8+ touches May-June; = Sep 8 S3 pivot (23,563). ~23,430 and the ~23,070 floor below."}, {"name": "CPR / broken-zone base (Sep 8)", "price": 23814, "type": "resistance", "status": "First bounce hurdle", "note": "Sep 8 CPR is 23,791-23,814 (ultra-narrow, ~23 pts = strong trend-day signal); R1 pivot 23,867 is the next hurdle."}, {"name": "Sep 1 low", "price": 23952.55, "type": "resistance", "status": "Well overhead - would neutralise the breakdown", "note": "= Sep 8 R2 pivot (23,954)."}, {"name": "200-day SMA", "price": 24595.27, "type": "resistance", "status": "Price ~-3.3% below (true 200-DMA)", "note": "200-period simple MA of daily close, computed from 200 daily bars. Deep overhead - not a near-term factor."}], "watchTomorrow": ["The break of 23,785-23,835 is marginal (close 23,779). Sep 8 decides it: a close below ~23,750 confirms the June band has failed (-> 23,600, then ~23,430); a close back above 23,835 is a bear trap and reopens 23,900-23,952.", "Sep 8 CPR is only ~23 pts wide (23,791-23,814) - historically a strong signal for a trending / expansion day, so expect a decisive move rather than a chop. Price closed just below it = bearish lean.", "Daily RSI 34.7 is near oversold - a flush to the 23,555-23,620 shelf would likely push RSI toward 31-32; watch for either an oversold bounce off that shelf or capitulation through it.", "Macro stays heavy: hot US payrolls lowered September Fed-cut odds; US CPI Wed-Thu Sep 10-11 is the next big event, then FOMC Sep 16-17. Brent ~$97 on US-Iran is the dominant swing factor - a de-escalation headline is the main upside risk.", "FII outflows and a 2%+ drop in Nifty IT were flagged as drags - watch whether IT stabilises or keeps leaking."], "tomorrowLevels": [{"name": "Sep 1 low / R2 pivot", "price": 23952.55, "type": "resistance", "action": "Breakdown-neutralisation level", "note": "A close above here would undo the break."}, {"name": "R1 pivot", "price": 23867, "type": "resistance", "action": "Bounce hurdle", "note": "Mid of the broken 23,785-23,835 zone is just below it."}, {"name": "CPR (Sep 8)", "price": 23802, "type": "resistance", "action": "Bias line - ultra-narrow, price closed below it", "note": "Band 23,791-23,814; reclaiming it flips the intraday bias."}, {"name": "Sep 7 low / S1 pivot", "price": 23730, "type": "support", "action": "Continuation trigger", "note": "Fri low 23,737.90; S1 pivot 23,715. A close below opens 23,650 then the shelf."}, {"name": "S2 pivot", "price": 23650, "type": "support", "action": "First downside target", "note": "Just above the 23,555-23,620 major shelf."}, {"name": "Next major support shelf", "price": 23600, "type": "support", "action": "Primary downside target", "note": "23,555-23,620, 8+ touches May-June; = S3 pivot 23,563."}], "newsEvents": [{"category": "Wed-Thu, Sep 10-11", "text": "US August CPI - the last major inflation read before the FOMC; a hot print cements a hawkish hold and pressures EM further.", "source": "Trading Economics"}, {"category": "Fri, Sep 12", "text": "India August CPI - elevated crude raises the inflation risk and narrows RBI's room.", "source": "-"}, {"category": "Tue-Wed, Sep 16-17", "text": "US FOMC rate decision + projections - hot payrolls (162k) have lowered September-cut odds; a hawkish hold pressures EM equities.", "source": "-"}, {"category": "Ongoing risk", "text": "Brent ~$97/bbl on fresh US-Iran attacks - direct headwind for India (imports ~85% of crude). Also FII outflows and USD strength post-NFP. De-escalation in crude is the main upside catalyst; escalation targets ~23,600 then ~23,430.", "source": "Business Standard; APAC News Network"}], "notes": "Finalised - replaces the ~10:45 IST provisional snapshot. Close/low/RSI/volume are final (Nifty 23,779.15, -0.50%, low 23,737.90, RSI 34.72, vol ~206M). sma200 (~24,595) extrapolated - SMA study API still not returning a value (exact 24,616.98 on Sep 2). S/R re-check done: (1) draw_list - 12 user chart lines unchanged; (2) new structure - Sep 7's low 23,737.90 is the new swing low; the 23,785-23,835 major zone is now BROKEN on a closing basis (marginal, ~6 pts); no new intermediate level (thin structure to 23,555-23,620); (3) pivots recomputed from Sep 7 H/L/C - Sep 8 CPR is ultra-narrow (23,791-23,814); (4) 200-DMA - API unavailable, extrapolated. Structural read: first close below the five-times-defended June support band on a hot-NFP + $97-Brent day. Marginal break - Sep 8's close confirms or rejects it. RSI 34.7 near oversold. Next real support 23,555-23,620.", "tradePlan": {"for": "2026-09-08", "lots": 3, "qty": 195, "instrument": "ATM weekly options (buy CE / PE)", "context": "NIFTY closed 23,779.15 - a marginal first close below the 23,785-23,835 major support (5-session floor). RSI 34.7, near oversold. The Sep 8 CPR is only ~23 pts wide (23,791-23,814), which historically flags a trending / expansion day - so expect a decisive move, not chop, and lean with the break unless price reclaims 23,835. Below Fri's low there is a ~120-pt air pocket to the 23,555-23,620 shelf (= S3 pivot 23,563). VIX is elevated on the crude spike so premiums are fat - keep size small, take T1 fast, hard time stop. All numbers in NIFTY / premium points. Watch Brent and the GIFT Nifty open - a crude move either way overrides the levels.", "pivots": {"basis": "standard formula on Sep 7 H/L/C = 23,890.00 / 23,737.90 / 23,779.15 (close = near the low)", "pdh": 23890.0, "pdl": 23737.9, "cpr": "23,790.8 (TC) - 23,802.4 (pivot) - 23,814.0 (BC); only ~23 pts wide = strong trend / expansion-day signal; price closed just below it = bearish lean", "r": "R1 23,867 - R2 23,954 - R3 24,019", "s": "S1 23,715 - S2 23,650 - S3 23,563 (= the 23,555-23,620 major shelf)"}, "setups": [{"name": "A - Oversold bounce / reclaim (buy ATM CE)", "bias": "long", "priority": "Counter-trend - RSI ~34.7", "trigger": "Either a 15-min CLOSE back above 23,814 (CPR top), or a 15-min reversal off 23,715-23,745 that holds above 23,710. Buy the strike nearest spot. Scalp only.", "entryTime": "~09:45-11:30 IST", "exitTime": "T1 in ~20-45 min; do not hold a CE past ~14:00; square off by 15:15 IST", "entry": "CE at NIFTY ~23,820 (reclaim) or ~23,745 (low bounce)", "stop": "Exit if premium -30% OR NIFTY 15-min < 23,700", "stopPoints": 35, "risk": "~35 premium pts (~45 index pts)", "targets": "T1 NIFTY 23,867 (R1 pivot) - book 2 lots. T2 23,900 / 23,954 (R2) on the runner, SL to breakeven."}, {"name": "B - Sell the retest (buy ATM PE)", "bias": "short", "priority": "Base case - retest of broken support", "trigger": "Bounce into 23,815-23,867 (broken 23,785-23,835 zone / CPR / R1 pivot), stalls, 15-min reversal back below 23,800. Buy PE nearest spot.", "entryTime": "~09:50-14:00 IST", "exitTime": "T1 in ~30-60 min; square off by 15:15 IST", "entry": "PE at NIFTY ~23,840", "stop": "Exit if premium -30% OR NIFTY 15-min > 23,900", "stopPoints": 35, "risk": "~35 premium pts (~60 index pts)", "targets": "T1 NIFTY 23,730 - book 2 lots. T2 23,650 (S2) on the runner."}, {"name": "C - Breakdown continuation (buy ATM PE)", "bias": "short", "priority": "Trend continuation - CPR is ultra-narrow", "trigger": "15-min candle CLOSE below 23,715 (S1 pivot / below Fri's 23,737.90 low). Enter on the close.", "entryTime": "any time it triggers, up to ~14:00 IST", "exitTime": "T1 in ~30-75 min; square off by 15:15 IST", "entry": "PE at NIFTY ~23,705", "stop": "Exit if premium -30% OR NIFTY back > 23,775", "stopPoints": 40, "risk": "~40 premium pts (~60 index pts)", "targets": "T1 NIFTY 23,650 (S2) - book 2 lots. T2 23,563 (S3 = the 23,555-23,620 shelf) on the runner."}, {"name": "D - Bear-trap reclaim (buy ATM CE)", "bias": "long", "priority": "Medium - a close back above 23,835 is a real signal", "trigger": "15-min candle CLOSE back above 23,835 (fully back inside the old support zone). Enter on the close.", "entryTime": "~09:45-13:00 IST", "exitTime": "T1 in ~30-60 min; square off by 15:15 IST", "entry": "CE at NIFTY ~23,845", "stop": "Exit if premium -30% OR NIFTY back < 23,795", "stopPoints": 40, "risk": "~40 premium pts (~55 index pts)", "targets": "T1 NIFTY 23,900 - book 2 lots. T2 23,954 (Sep 1 low / R2 pivot) on the runner."}], "timing": ["No buys in the first 20-25 min (09:15-09:40) - post-open IV crush hurts fresh option longs.", "The ultra-narrow CPR argues for a trending day - a breakout/breakdown (C or D) is more likely to follow through than a range fade; but still buy only on a clean 15-min signal.", "Best windows 09:45-11:30 and 13:15-14:00. Avoid the 11:30-13:00 lull.", "Hard TIME STOP: not moving your way in ~30 min = exit (20 min on the counter-trend CE, setup A).", "US CPI is Wed Sep 10 - Tuesday still has room to move but expect pre-CPI caution to build into the afternoon; nothing fresh after ~14:00.", "Square off ALL intraday positions by 15:15 IST. Stand aside 15-20 min if Brent / GIFT gaps sharply at the open."], "sizingNote": "195 qty across 3 lots - points only. Risk per trade ~35-40 premium pts; T1 ~+35-45 premium pts; T2 ~+70. Scale OUT (2 lots at T1, trail the 3rd at breakeven), never average down. Premiums are fat on elevated VIX - take T1 quickly. With RSI near oversold the counter-trend bounce (A) is a scalp, not a swing; the higher-odds trades are B (retest sell) and C (breakdown) while price stays below 23,835.", "disclaimer": "Level-based scenarios for BUYING ATM options, not investment advice. Wait for the stated trigger; premium stops and the time stop are mandatory; confirm with live price, IV and your own risk limits."}, "cpr": {"width": 35, "label": "narrow", "range": "23,915.40-23,950.80", "basis": "from 2026-09-04 H/L/C"}}, {"date": "2026-09-08", "symbol": "NSE:NIFTY", "close": 23635.1, "change": -144.05, "changePct": -0.61, "open": 23743.1, "dayHigh": 23758.95, "dayLow": 23623.1, "dayLowTime": "intraday", "prevClose": 23779.15, "rsi14": 30.88, "sma200": 24583.9, "giftPremarketHigh": null, "giftPremarketTime": null, "cpr": {"width": 23, "label": "narrow", "range": "23,791-23,814", "basis": "from 2026-09-07 H/L/C"}, "summary": "FINALISED (session closed). Second straight down day and the sixth red close in seven sessions. NIFTY gapped down to 23,743.10, trended lower all session and closed at 23,635.10, down 144.05 (-0.61%) - right inside the 23,555-23,662 major demand zone, which a full swing re-scan confirms is the next real support below the broken June band. The day's low (23,623.10) held that zone's base. Sensex -555 at 75,577 (also its 2nd straight fall); TCS -1%+, with banks and IT again the drags on Brent (~$97.5) and US-Iran risk plus persistent FII outflows. Daily RSI(14) is 30.88 - textbook oversold and the lowest reading of the entire down-move. The June support band (24,090-23,785) is decisively broken; price has fallen ~450 pts in four sessions to this shelf. Make-or-break: a hold of 23,555 with RSI at oversold sets up a mean-reversion bounce (first targets 23,730-23,835, then the dense 23,880-24,010 supply wall); a daily close below 23,555 opens 23,346-23,430, then the ~23,063-23,115 major floor.", "levels": [{"name": "R3 - dense supply wall (23,880-24,010)", "price": 23945, "type": "resistance", "status": "Marked on chart - where a bounce is likely to stall", "note": "The single densest resistance band on the chart (late-Aug / early-Sep congestion)."}, {"name": "R2 - broken June band, top", "price": 23835, "type": "resistance", "status": "Marked on chart - retest-sell zone", "note": "Top of the 23,730-23,835 band that was 5-session support Aug 19-Sep 3. A close above 23,835 would be a delayed bear trap. Approx Sep 9 R3 pivot 23,858."}, {"name": "R1 - broken June band, base", "price": 23730, "type": "resistance", "status": "Marked on chart - first bounce hurdle", "note": "Base of the broken band; Sep 8 high 23,758.95; Sep 9 R1 pivot 23,722."}, {"name": "S1 - 23,555-23,662 major demand zone (base)", "price": 23555, "type": "support", "status": "Marked on chart - UNDER TEST (closed 23,635 inside the zone)", "note": "10+ touches May-June; base ~23,555, upper edge ~23,662. Day low 23,623 held. Sep 9 S1 pivot 23,586. A daily close below ~23,555 confirms the break."}, {"name": "S2 - next major support (23,346-23,430)", "price": 23400, "type": "support", "status": "Marked on chart - next real shelf below", "note": "Strong May-June cluster (8+ touches). Sep 9 S3 pivot 23,450 sits at its top. Moderate step ~23,247-23,320 between it and the floor."}, {"name": "S3 - major floor (23,063-23,115)", "price": 23090, "type": "support", "status": "Marked on chart - the big one", "note": "March-May floor, repeatedly defended; extends to ~23,185. Below: ~22,930-23,000, then March lows ~22,470-22,625 / ~22,180-22,330."}, {"name": "24,050-24,145 (old June cap) - context, not marked", "price": 24095, "type": "resistance", "status": "Far overhead - beyond the marked 3+3", "note": "The 2-week cap that broke on Sep 7; strong ~24,050-24,145, then 24,296-24,400."}, {"name": "200-day SMA - context, not marked", "price": 24583.9, "type": "resistance", "status": "Price ~-3.9% below (true 200-DMA)", "note": "200-period simple MA of daily close, computed from 200 daily bars. Deep overhead - not a near-term factor."}], "watchTomorrow": ["23,555 is the line. Closed inside the 23,555-23,662 major demand zone with RSI at 30.88 (oversold). Hold it -> mean-reversion bounce toward 23,730-23,835, then the dense 23,880-24,010 wall. Daily close below 23,555 -> 23,346-23,430, then the ~23,063-23,115 floor.", "Daily RSI 30.88 is textbook oversold and the lowest of the down-move - historically this precedes a sharp bounce, but only once selling exhausts; a gap-down open through 23,585 would say it has not.", "Sep 9 pivots (from Sep 8 H/L/C): CPR 23,654-23,691 (narrow, ~37 pts; price closed below it = bearish lean); R1 23,722 / R2 23,808 / R3 23,858; S1 23,586 / S2 23,537 / S3 23,450. Confluence: S1 pivot on the zone base, R2 pivot on the broken-band base, S3 pivot on the next support zone.", "US CPI is Wed Sep 10 - the last inflation read before the FOMC (Sep 16-17); a hot print cements a hawkish hold. India CPI Fri Sep 12. Brent ~$97.5 on US-Iran remains the dominant swing factor - de-escalation is the main upside catalyst.", "Two straight Sensex falls, TCS and banks leading down - watch whether IT / financials stabilise or keep leaking."], "tomorrowLevels": [{"name": "23,880-24,010 supply wall", "price": 23945, "type": "resistance", "action": "Where a bounce is likely to die", "note": "Densest resistance on the chart."}, {"name": "23,785-23,835 broken band / R2-R3 pivots", "price": 23808, "type": "resistance", "action": "Retest-sell zone", "note": "R2 pivot 23,808, R3 23,858. A close above 23,835 = delayed bear trap."}, {"name": "Sep 8 high / R1 pivot", "price": 23730, "type": "resistance", "action": "First bounce hurdle", "note": "Sep 8 high 23,758.95; R1 pivot 23,722."}, {"name": "CPR (Sep 9)", "price": 23672, "type": "resistance", "action": "Bias line - price closed below the whole band", "note": "Band 23,654-23,691; reclaiming it flips the intraday bias neutral."}, {"name": "23,555-23,662 major demand zone (marked S1)", "price": 23555, "type": "support", "action": "Primary bounce zone / breakdown line", "note": "Base 23,555 = the drawn line and Sep 9 S1 pivot 23,586. A daily close below ~23,555 confirms the break."}, {"name": "Next major support 23,346-23,430 (marked S2)", "price": 23400, "type": "support", "action": "Downside target if the zone fails on a close", "note": "Drawn line 23,400; Sep 9 S3 pivot 23,450 at the zone's top; strong May-June cluster."}, {"name": "23,063-23,115 major floor", "price": 23090, "type": "support", "action": "The bigger-picture downside reference", "note": "March-May floor."}], "newsEvents": [{"category": "Wed, Sep 10", "text": "US August CPI - the last major inflation read before the FOMC; a hot print cements a hawkish hold and pressures EM equities.", "source": "Trading Economics"}, {"category": "Fri, Sep 12", "text": "India August CPI - elevated crude raises the inflation risk and narrows the RBI's room.", "source": "-"}, {"category": "Tue-Wed, Sep 16-17", "text": "US FOMC rate decision + projections - hot payrolls (162k) have lowered September-cut odds; a hawkish hold weighs on EM.", "source": "-"}, {"category": "Ongoing risk", "text": "Brent ~$97.5/bbl on US-Iran hostilities - direct headwind for India (imports ~85% of crude). Plus FII outflows and post-NFP USD strength. De-escalation in crude is the main upside catalyst; a break of 23,555 targets 23,346-23,430.", "source": "Business Standard; India TV News"}], "notes": "Finalised - replaces the ~10:45 IST provisional. Close 23,635.10, -0.61%, low 23,623.10, RSI 30.88 (oversold), vol ~230M. sma200 (~24,585) extrapolated - SMA study API still down (exact 24,616.98 on Sep 2). S/R re-check (user asked for a full one): (1) draw_list - 12 user chart lines unchanged; (2) FULL 125-bar swing re-scan done (Feb-Sep 2026). Confirmed / refined ladder - SUPPORT: 23,555-23,662 (major, 10+ touches May-June, under test now; widened from the old '23,555-23,620' label) / 23,346-23,430 (strong May-June cluster - the old '~23,430' is really this zone) / moderate step ~23,247-23,320 / 23,063-23,115 (major floor, extends to ~23,185) / then ~22,930-23,000, ~22,470-22,625, ~22,180-22,330. RESISTANCE: 23,730-23,835 (broken June band, immediate) / 23,880-24,010 (the densest supply band on the chart - weeks of chop) / 24,050-24,145 (old cap) / 24,296-24,400 / 24,427-24,530 / 24,570-24,640 / 24,774 (Aug 3 top). (3) pivots recomputed from Sep 8 H/L/C for Sep 9 - CPR 23,654-23,691, price closed below it. (4) 200-DMA - API unavailable, extrapolated. Structural read: the June band is decisively broken; price is now testing the next major demand zone (23,555-23,662) with RSI at textbook oversold (30.88). Hold = mean-reversion bounce into the 23,880-24,010 wall; close below 23,555 = 23,346-23,430 then the ~23,090 floor.", "tradePlan": {"for": "2026-09-09", "lots": 3, "qty": 195, "instrument": "ATM weekly options (buy CE / PE)", "context": "NIFTY closed 23,635.10 - deep inside the 23,555-23,662 major demand zone (the re-scan-confirmed next support) with daily RSI at 30.88 (textbook oversold, lowest of the down-move). That is a classic mean-reversion setup IF 23,555 holds - but the trend is firmly down and every bounce for two weeks has been sold. Sep 9 CPR is ~37 pts (narrow) and price closed below it -> bearish lean, expect another trending day. A hold above ~23,660 favours a bounce toward 23,730-23,808; a break of 23,585 opens 23,450 then the 23,346-23,430 shelf. VIX is elevated so premiums are fat - keep size small, take T1 fast, hard time stop. All numbers in NIFTY / premium points. Watch Brent - a de-escalation headline snaps this back hard through the overhead levels.", "pivots": {"basis": "standard formula on Sep 8 H/L/C = 23,758.95 / 23,623.10 / 23,635.10 (close near the low)", "pdh": 23758.95, "pdl": 23623.1, "cpr": "23,653.7 (TC) - 23,672.4 (pivot) - 23,691.0 (BC); ~37 pts wide (narrow); price closed below the whole band = bearish lean", "r": "R1 23,722 - R2 23,808 (broken-band base) - R3 23,858", "s": "S1 23,586 (zone base) - S2 23,537 - S3 23,450 (top of the 23,346-23,430 shelf)"}, "setups": [{"name": "A - Oversold bounce off the zone (buy ATM CE)", "bias": "long", "priority": "Base case - RSI 30.88 at major support", "trigger": "Either a 15-min reversal candle off 23,555-23,635 holding above 23,545, or a 15-min CLOSE back above 23,691 (CPR top). Buy the strike nearest spot. Counter-trend - treat as a scalp.", "entryTime": "~09:45-12:30 IST", "exitTime": "T1 in ~20-45 min; do not hold a CE past ~14:00; square off by 15:15 IST", "entry": "CE at NIFTY ~23,640 (zone bounce) or ~23,700 (CPR reclaim)", "stop": "Exit if premium -30% OR NIFTY 15-min < 23,540", "stopPoints": 35, "risk": "~35 premium pts (~50 index pts)", "targets": "T1 NIFTY 23,722 (R1 pivot) - book 2 lots. T2 23,760 (Sep 8 high) / 23,808 (R2 / broken-band base) on the runner, SL to breakeven."}, {"name": "B - Sell the bounce (buy ATM PE)", "bias": "short", "priority": "With-trend - fade a weak bounce into the broken band", "trigger": "Bounce into 23,730-23,835 (broken June band / R2-R3 pivots), stalls, 15-min reversal back below 23,715. Buy PE nearest spot.", "entryTime": "~10:00-14:00 IST", "exitTime": "T1 in ~30-60 min; square off by 15:15 IST", "entry": "PE at NIFTY ~23,780", "stop": "Exit if premium -30% OR NIFTY 15-min > 23,860", "stopPoints": 35, "risk": "~35 premium pts (~65 index pts)", "targets": "T1 NIFTY 23,660 - book 2 lots. T2 23,590 on the runner."}, {"name": "C - Zone breakdown (buy ATM PE)", "bias": "short", "priority": "High-impact - the last shelf before 23,430 gives way", "trigger": "15-min candle CLOSE below 23,585 (S1 pivot / base of the 23,555-23,662 zone). Enter on the close.", "entryTime": "any time it triggers, up to ~14:00 IST", "exitTime": "T1 in ~30-75 min; square off by 15:15 IST", "entry": "PE at NIFTY ~23,575", "stop": "Exit if premium -30% OR NIFTY back > 23,650", "stopPoints": 40, "risk": "~40 premium pts (~65 index pts)", "targets": "T1 NIFTY 23,450 (S3 pivot / top of 23,346-23,430) - book 2 lots. T2 23,350 on the runner (then the ~23,090 floor is the bigger picture)."}, {"name": "D - Reclaim long (buy ATM CE)", "bias": "long", "priority": "Low - into the dense 23,880-24,010 wall", "trigger": "15-min candle CLOSE back above 23,835 (above the broken June band). Enter on the close.", "entryTime": "~09:45-13:00 IST", "exitTime": "T1 in ~30-60 min; square off by 15:15 IST", "entry": "CE at NIFTY ~23,845", "stop": "Exit if premium -30% OR NIFTY back < 23,795", "stopPoints": 40, "risk": "~40 premium pts (~55 index pts)", "targets": "T1 NIFTY 23,900 - book 2 lots. T2 23,955 on the runner (expect stalling into 23,880-24,010)."}], "timing": ["No buys in the first 20-25 min (09:15-09:40) - post-open IV crush.", "RSI is deep-oversold at major support, so an intraday bounce (A) is the higher-odds trade - but keep it a scalp; the trend context stays bearish.", "Best windows 09:45-11:30 and 13:15-14:00. Avoid the 11:30-13:00 lull.", "Hard TIME STOP: not moving your way in ~30 min = exit (20 min on the counter-trend CE, setup A).", "US CPI is Wed Sep 10 - the Sep 9 afternoon will likely turn cautious ahead of it; nothing fresh after ~14:00.", "Square off ALL intraday positions by 15:15 IST. Stand aside 15-20 min if Brent / GIFT gaps sharply at the open."], "sizingNote": "195 qty across 3 lots - points only. Risk per trade ~35-40 premium pts; T1 ~+35-45 premium pts; T2 ~+70. Scale OUT (2 lots at T1, trail the 3rd at breakeven), never average down. Premiums are fat on high VIX - take T1 quickly. With RSI at 30.88 on the last major support before 23,430, the bounce (A) is the primary read and C is the high-reward tail if 23,555 gives way; B is the with-trend fade of any weak bounce.", "disclaimer": "Level-based scenarios for BUYING ATM options, not investment advice. Wait for the stated trigger; premium stops and the time stop are mandatory; confirm with live price, IV and your own risk limits."}, "markedLevels": {"markedOn": "2026-09-08", "spot": 23635.1, "note": "3 resistance + 3 support drawn on the TradingView chart (dashed; red = resistance, green = support) from spot 23,635; all older chart lines removed. These 6 prices also anchor the Levels table above.", "resistance": [{"price": 23730, "label": "R1 - broken-band base / Sep 8 high / pivot R1"}, {"price": 23835, "label": "R2 - broken June band top (retest-sell)"}, {"price": 23945, "label": "R3 - dense supply wall 23,880-24,010"}], "support": [{"price": 23555, "label": "S1 - base of 23,555-23,662 demand zone / pivot S1"}, {"price": 23400, "label": "S2 - next major support 23,346-23,430"}, {"price": 23090, "label": "S3 - major floor 23,063-23,115"}]}}]